<Application x:Class="RetailApp.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:viewmodels="clr-namespace:RetailApp.ViewModels"
             xmlns:views="clr-namespace:RetailApp.Views"
             xmlns:conv="clr-namespace:RetailApp.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Lime" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Defaults.xaml" />
                <ResourceDictionary Source="pack://application:,,,/RetailApp;component/Styles/Themes/LightTheme.xaml" />
                <ResourceDictionary Source="pack://application:,,,/RetailApp;component/Styles/ModernStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
            <conv:InvertBooleanConverter x:Key="InvertBooleanConverter"/>
            <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>

            <DataTemplate DataType="{x:Type viewmodels:LoginViewModel}">
                <views:LoginView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:MainViewModel}">
                <views:MainView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:PosViewModel}">
                <views:PosView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:InventoryViewModel}">
                <views:InventoryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:CustomersViewModel}">
                <views:CustomersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:SuppliersViewModel}">
                <views:SuppliersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:UsersViewModel}">
                <views:UsersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:PurchasesViewModel}">
                <views:PurchasesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:WarehouseViewModel}">
                <views:WarehouseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:InstallmentsViewModel}">
                <views:InstallmentsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ExpensesViewModel}">
                <views:ExpensesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ReportsViewModel}">
                <views:ReportsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:BackupViewModel}">
                <views:BackupView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>

            <!-- Missing DataTemplates Added -->
            <DataTemplate DataType="{x:Type viewmodels:FirstRunWizardViewModel}">
                <views:FirstRunWizardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:LicenseViewModel}">
                <views:LicenseView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:SalesViewModel}">
                <views:SalesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ReturnsViewModel}">
                <views:ReturnsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:ChartOfAccountsViewModel}">
                <views:ChartOfAccountsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:JournalEntriesViewModel}">
                <views:JournalEntriesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:EmployeesViewModel}">
                <views:EmployeesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:PayrollViewModel}">
                <views:PayrollView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:DeveloperDashboardViewModel}">
                <views:DeveloperDashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type viewmodels:UpdateViewModel}">
                <views:UpdateView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
