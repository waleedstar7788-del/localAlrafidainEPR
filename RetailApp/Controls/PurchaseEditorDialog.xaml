<UserControl x:Class="RetailApp.Controls.PurchaseEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="1100" Height="800" Background="Transparent">
    
    <Border Style="{StaticResource DialogContainer}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header Info -->
                <RowDefinition Height="*"/>    <!-- Items Grid -->
                <RowDefinition Height="Auto"/> <!-- Totals & Actions -->
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <materialDesign:PackIcon Kind="CartArrowDown" Foreground="{DynamicResource BrandPrimaryBrush}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="فاتورة مشتريات جديدة" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="المورد" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="SupplierName" 
                                      Style="{StaticResource ModernComboBox}" materialDesign:HintAssist.Hint="اختر المورد"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رقم الفاتورة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Invoice.InvoiceNumber, Mode=TwoWay}" IsReadOnly="True"
                                     Style="{StaticResource ModernTextBox}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="المخزن" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding Invoice.WarehouseName, Mode=TwoWay}" 
                                     Style="{StaticResource ModernTextBox}" materialDesign:HintAssist.Hint="المستودع الرئيسي"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══ ITEMS GRID ═══ -->
            <Border Grid.Row="1" Style="{StaticResource KpiCard}" Padding="0" ClipToBounds="True" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <TextBlock Text="المنتجات" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Left" Style="{StaticResource ModernPrimaryButton}" Command="{Binding AddItemCommand}" Height="36" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="إضافة منتج" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Invoice.Items}" AutoGenerateColumns="False" CanUserAddRows="False" 
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المنتج (ID)" Binding="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                            
                            <DataGridTemplateColumn Header="الكمية" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4" Height="32"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="سعر الشراء" Width="1.2*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding PurchasePrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4" Height="32"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="الخصم" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4" Height="32"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTemplateColumn Header="الضريبة" Width="1*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding Tax, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4" Height="32"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="الإجمالي الفرعي" Binding="{Binding SubTotal, Mode=OneWay, StringFormat={}{0:N2}}" Width="1.5*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrandSuccessBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ModernIconButton}" Foreground="{DynamicResource BrandDangerBrush}" Width="32" Height="32" Padding="0"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══ TOTALS & ACTIONS ═══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="استكمال الشراء" Command="{Binding CompletePurchaseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                            Style="{StaticResource ModernSuccessButton}" Width="160" Height="44" Margin="0,0,12,0"/>
                    <Button Content="حفظ كمسودة" Command="{Binding SaveDraftCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                            Style="{StaticResource ModernWarningButton}" Width="120" Height="44" Margin="0,0,12,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                            Style="{StaticResource ModernSecondaryButton}" Width="100" Height="44"/>
                </StackPanel>

                <Border Grid.Column="2" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="الإجمالي الفرعي:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Invoice.SubTotal, StringFormat={}{0:N2}}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="قيمة الخصم:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Invoice.DiscountAmount, StringFormat={}{0:N2}}" Foreground="{DynamicResource BrandWarningBrush}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="الضريبة:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding Invoice.TaxAmount, StringFormat={}{0:N2}}" Foreground="{DynamicResource BrandDangerBrush}" HorizontalAlignment="Left" FontWeight="SemiBold"/>
                        </Grid>
                        <Separator Background="{DynamicResource BorderBrush}" Margin="0,8,0,16"/>
                        <Grid>
                            <TextBlock Text="الإجمالي المستحق:" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Invoice.TotalAmount, StringFormat={}{0:N2}}" FontWeight="Bold" Foreground="{DynamicResource BrandSuccessBrush}" FontSize="24" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
