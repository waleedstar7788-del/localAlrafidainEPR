<UserControl x:Class="RetailApp.Controls.CustomerProfileDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="850" Height="650" Background="Transparent">
    
    <Border Style="{StaticResource DialogContainer}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <Border Width="64" Height="64" CornerRadius="32" Background="{DynamicResource BrandInfoTransparentBrush}" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="Account" Foreground="{DynamicResource BrandPrimaryBrush}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Customer.FullName}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding Customer.CustomerNumber, StringFormat=رقم العميل: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
                
                <Button Grid.Column="2" Style="{StaticResource ModernIconButton}" VerticalAlignment="Top"
                        Command="{Binding CloseCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}">
                    <materialDesign:PackIcon Kind="Close" Width="20" Height="20"/>
                </Button>
            </Grid>

            <!-- ═══ CONTENT ═══ -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Column (Financials & History) -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="الملخص المالي" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border Grid.Column="0" Style="{StaticResource KpiCard}" BorderBrush="{DynamicResource BrandDangerBrush}" BorderThickness="0,0,0,2">
                                <StackPanel>
                                    <TextBlock Text="الرصيد المتبقي" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Customer.CurrentBalance, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandDangerBrush}"/>
                                </StackPanel>
                            </Border>
                            
                            <Border Grid.Column="2" Style="{StaticResource KpiCard}" BorderBrush="{DynamicResource BrandPrimaryBrush}" BorderThickness="0,0,0,2">
                                <StackPanel>
                                    <TextBlock Text="الحد الائتماني" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                                    <TextBlock Text="{Binding Customer.CreditLimit, StringFormat={}{0:N2}}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="آخر العمليات" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <Border Style="{StaticResource KpiCard}" MinHeight="200" HorizontalAlignment="Stretch" Padding="0">
                            <Grid>
                                <!-- Empty State -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Visibility="{Binding NoInvoices, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <materialDesign:PackIcon Kind="History" Width="40" Height="40" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                    <TextBlock Text="لا توجد مبيعات مسجلة بعد" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" HorizontalAlignment="Center"/>
                                </StackPanel>
                                
                                <!-- Invoices List -->
                                <DataGrid ItemsSource="{Binding Invoices}" 
                                          AutoGenerateColumns="False" 
                                          IsReadOnly="True"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                                          Background="Transparent"
                                          RowBackground="Transparent"
                                          Visibility="{Binding HasInvoices, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="رقم الفاتورة" Binding="{Binding InvoiceNumber}" Width="120" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                        <DataGridTextColumn Header="التاريخ" Binding="{Binding CreatedDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                                        <DataGridTextColumn Header="الإجمالي" Binding="{Binding GrandTotal, StringFormat={}{0:N2}}" Width="100">
                                            <DataGridTextColumn.ElementStyle>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                                </Style>
                                            </DataGridTextColumn.ElementStyle>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="المدفوع" Binding="{Binding PaidAmount, StringFormat={}{0:N2}}" Width="100" Foreground="{DynamicResource BrandSuccessBrush}"/>
                                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat={}{0:N2}}" Width="100" Foreground="{DynamicResource BrandDangerBrush}"/>
                                        <DataGridTextColumn Header="الحالة" Binding="{Binding Status}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Right Column (Personal Info) -->
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="المعلومات الشخصية" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                        
                        <Border Style="{StaticResource KpiCard}" Padding="20">
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="الشركة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                    <TextBlock Text="{Binding Customer.CompanyName, TargetNullValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" HorizontalAlignment="Left" Margin="80,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="الهاتف" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                    <TextBlock Text="{Binding Customer.Phone1, TargetNullValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" HorizontalAlignment="Left" Margin="80,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="البريد" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                    <TextBlock Text="{Binding Customer.Email, TargetNullValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" HorizontalAlignment="Left" Margin="80,0,0,0"/>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="العنوان" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                    <TextBlock Text="{Binding Customer.Address, TargetNullValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" HorizontalAlignment="Left" Margin="80,0,0,0" TextWrapping="Wrap"/>
                                </Grid>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="الضريبي" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                    <TextBlock Text="{Binding Customer.TaxNumber, TargetNullValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" HorizontalAlignment="Left" Margin="80,0,0,0"/>
                                </Grid>
                                <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>
                                <Grid>
                                    <TextBlock Text="التسجيل" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                                    <TextBlock Text="{Binding Customer.RegistrationDate, StringFormat=yyyy-MM-dd}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="Medium" HorizontalAlignment="Left" Margin="80,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
