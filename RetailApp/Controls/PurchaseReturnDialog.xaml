<UserControl x:Class="RetailApp.Controls.PurchaseReturnDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="1000" Height="700" Background="Transparent">
             
    <Border Style="{StaticResource DialogContainer}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,24">
                    <materialDesign:PackIcon Kind="TruckFast" Foreground="{DynamicResource BrandDangerBrush}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="مرتجع مشتريات (للمورد)" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,24">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="المورد" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <ComboBox ItemsSource="{Binding Suppliers}" SelectedItem="{Binding SelectedSupplier}" DisplayMemberPath="SupplierName" 
                                      Style="{StaticResource ModernComboBox}" materialDesign:HintAssist.Hint="اختر المورد"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="رقم الفاتورة الأصلية" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <TextBox Text="{Binding ReturnInvoice.PurchaseInvoiceId, Mode=TwoWay}" 
                                     Style="{StaticResource ModernTextBox}" materialDesign:HintAssist.Hint="ID الفاتورة (اختياري)"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="طريقة الاسترداد" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                            <ComboBox SelectedItem="{Binding ReturnInvoice.RefundMethod, Mode=TwoWay}" 
                                      Style="{StaticResource ModernComboBox}" SelectedIndex="0">
                                <ComboBoxItem Content="رصيد دائن (خصم من ديوننا)"/>
                                <ComboBoxItem Content="استرداد نقدي (Cash)"/>
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══ ITEMS GRID ═══ -->
            <Border Grid.Row="1" Style="{StaticResource KpiCard}" Padding="0" ClipToBounds="True" Margin="0,0,0,24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,16">
                        <Grid>
                            <TextBlock Text="المنتجات المرتجعة" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button HorizontalAlignment="Left" Style="{StaticResource ModernPrimaryButton}" Command="{Binding AddItemCommand}" Height="36" Padding="12,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="إضافة منتج" FontSize="13"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <DataGrid Grid.Row="1" ItemsSource="{Binding ReturnInvoice.Items}" AutoGenerateColumns="False" 
                              CanUserAddRows="False" Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المنتج (ID)" Binding="{Binding ProductId, UpdateSourceTrigger=PropertyChanged}" Width="1.5*"/>
                            
                            <DataGridTemplateColumn Header="الكمية المرتجعة" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding QuantityReturned, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4" Height="32"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="سعر الاسترداد" Width="1.5*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBox Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource ModernTextBox}" Padding="8,4" Height="32"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding SubTotal, Mode=OneWay, StringFormat={}{0:N2}}" Width="2*" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                        <Setter Property="Foreground" Value="{DynamicResource BrandDangerBrush}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            
                            <DataGridTemplateColumn Width="60">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ModernIconButton}" Foreground="{DynamicResource BrandDangerBrush}" Width="32" Height="32" Padding="0"
                                                Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- ═══ ACTIONS ═══ -->
            <Grid Grid.Row="2">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Button Content="إتمام المرتجع للمورد" Command="{Binding ProcessReturnCommand}" Style="{StaticResource ModernDangerButton}" Width="180" Height="44" Margin="0,0,12,0"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Style="{StaticResource ModernSecondaryButton}" Width="100" Height="44"/>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <TextBlock Text="إجمالي المسترد:" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="16" Margin="0,0,16,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ReturnInvoice.TotalRefundAmount, StringFormat={}{0:N2} ريال}" FontWeight="Bold" Foreground="{DynamicResource BrandDangerBrush}" FontSize="24" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</UserControl>
