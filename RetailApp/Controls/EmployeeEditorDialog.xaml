<UserControl x:Class="RetailApp.Controls.EmployeeEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             Width="650" Height="600">
             
    <Border Style="{StaticResource DialogContainer}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                <materialDesign:PackIcon Kind="AccountBadge" Foreground="{DynamicResource BrandPrimaryBrush}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="إضافة موظف جديد" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Form Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,24" Padding="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="البيانات الشخصية" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                    <TextBox materialDesign:HintAssist.Hint="الاسم الكامل" Style="{StaticResource ModernTextBox}" Text="{Binding FullName}" Margin="0,0,0,16"/>
                    
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="رقم الهوية الوطنية" Style="{StaticResource ModernTextBox}" Text="{Binding NationalId}"/>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="رقم الهاتف" Style="{StaticResource ModernTextBox}" Text="{Binding Phone}"/>
                    </Grid>
                    
                    <TextBox materialDesign:HintAssist.Hint="العنوان" Style="{StaticResource ModernTextBox}" Text="{Binding Address}" Margin="0,0,0,24"/>

                    <TextBlock Text="البيانات الوظيفية والمالية" Foreground="{DynamicResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,16"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="القسم (Department)" Style="{StaticResource ModernTextBox}" Text="{Binding Department}"/>
                        <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="المسمى الوظيفي (Job Title)" Style="{StaticResource ModernTextBox}" Text="{Binding JobTitle}"/>
                    </Grid>

                    <TextBox materialDesign:HintAssist.Hint="الراتب الأساسي الشهري" Style="{StaticResource ModernTextBox}" 
                             Text="{Binding MonthlySalary, StringFormat={}{0:N2}}" Foreground="{DynamicResource BrandSuccessBrush}" FontWeight="Bold" FontSize="16"/>
                </StackPanel>
            </ScrollViewer>

            <!-- Actions -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="حفظ الموظف" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                        Style="{StaticResource ModernPrimaryButton}" Width="140" Height="44" Margin="0,0,12,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                        Style="{StaticResource ModernSecondaryButton}" Width="100" Height="44"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
