<UserControl x:Class="RetailApp.Controls.Pos.CartItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">
    
    <Border Background="#05FFFFFF" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Product.Name}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding UnitPrice, StringFormat='c'}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            
            <!-- Quantity Controls -->
            <Border Grid.Column="1" Background="{DynamicResource SurfaceHighlightStrongBrush}" CornerRadius="18" Padding="4" Margin="12,0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ModernIconButton}" Width="28" Height="28" Padding="0"
                            Command="{Binding DataContext.DecreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <materialDesign:PackIcon Kind="Minus" Width="16" Height="16"/>
                    </Button>
                    
                    <TextBlock Text="{Binding Quantity}" Width="32" TextAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    
                    <Button Style="{StaticResource ModernIconButton}" Width="28" Height="28" Padding="0"
                            Command="{Binding DataContext.IncreaseQuantityCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16"/>
                    </Button>
                </StackPanel>
            </Border>
            
            <!-- Total -->
            <TextBlock Grid.Column="2" Text="{Binding Total, StringFormat='c'}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
            
            <!-- Remove -->
            <Button Grid.Column="3" Style="{StaticResource ModernIconButton}" Foreground="{DynamicResource BrandDangerBrush}" Width="32" Height="32" Padding="0" Margin="12,0,0,0" 
                    Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                <materialDesign:PackIcon Kind="DeleteOutline" Width="18" Height="18"/>
            </Button>
        </Grid>
    </Border>
</UserControl>
