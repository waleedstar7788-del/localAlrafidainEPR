<UserControl x:Class="RetailApp.Controls.InstallmentPaymentDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent"
             Width="500" Height="450">

    <Border Style="{StaticResource DialogContainer}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,24">
                <materialDesign:PackIcon Kind="CashPlus" Foreground="{DynamicResource BrandSuccessBrush}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="تسديد قسط" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Form -->
            <StackPanel Grid.Row="1" Margin="0,0,0,24">
                <Border Style="{StaticResource KpiCard}" BorderBrush="{DynamicResource BrandDangerBrush}" BorderThickness="0,0,0,2" Padding="20" Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="{Binding Schedule.InstallmentNumber, StringFormat=قسط رقم: {0}}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding Schedule.RemainingAmount, StringFormat=المبلغ المتبقي: {0:N2} ريال}" Foreground="{DynamicResource BrandDangerBrush}" FontSize="20" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                
                <TextBox materialDesign:HintAssist.Hint="المبلغ المدفوع (Amount)" Style="{StaticResource ModernTextBox}" Text="{Binding AmountToPay}" Margin="0,0,0,16"/>
                
                <TextBox materialDesign:HintAssist.Hint="ملاحظات" Style="{StaticResource ModernTextBox}" Text="{Binding Notes}" Margin="0,0,0,16"/>
            </StackPanel>

            <!-- Actions -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="دفع واعتماد" Command="{Binding ProcessPaymentCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                        Style="{StaticResource ModernSuccessButton}" Width="140" Height="44" Margin="0,0,12,0"/>
                <Button Content="إلغاء" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}" 
                        Style="{StaticResource ModernSecondaryButton}" Width="100" Height="44"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
