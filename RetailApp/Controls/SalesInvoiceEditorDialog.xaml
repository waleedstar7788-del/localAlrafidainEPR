<UserControl x:Class="RetailApp.Controls.SalesInvoiceEditorDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Width="1100" Height="800" Background="Transparent">
    
    <Border Style="{StaticResource DialogContainer}">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header Info -->
                <RowDefinition Height="*"/>     <!-- Items Grid -->
                <RowDefinition Height="Auto"/>  <!-- Totals & Actions -->
            </Grid.RowDefinitions>

            <!-- ═══ HEADER ═══ -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                    <materialDesign:PackIcon Kind="ReceiptTextEdit" Foreground="{DynamicResource BrandPrimaryBrush}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="تعديل فاتورة المبيعات" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <Border Background="{DynamicResource BrandInfoTransparentBrush}" CornerRadius="8" Padding="12,4" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Invoice.InvoiceNumber}" Foreground="{DynamicResource BrandInfoBrush}" FontWeight="SemiBold" FontSize="14"/>
                    </Border>
                </StackPanel>

                <!-- Invoice Info Bar -->
                <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="العميل" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Invoice.Customer.FullName, TargetNullValue='عميل نقدي'}" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="التاريخ" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Invoice.InvoiceDate, StringFormat={}{0:dd/MM/yyyy hh:mm tt}}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="4">
                            <TextBlock Text="الكاشير" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Invoice.CashierName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="6">
                            <TextBlock Text="طريقة الدفع" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                            <TextBlock Text="{Binding Invoice.PaymentMethod}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ═══ ITEMS TABLE ═══ -->
            <Border Grid.Row="1" Style="{StaticResource KpiCard}" Padding="0" ClipToBounds="True" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Search Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border x:Name="SearchBorderEditor" Grid.Column="0" Style="{StaticResource SearchBarBorder}" Background="{DynamicResource BgCardBrush}" HorizontalAlignment="Stretch">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0,10,0" Width="18" Height="18"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             materialDesign:HintAssist.Hint="ابحث عن منتج لإضافته..."
                                             materialDesign:HintAssist.Foreground="{DynamicResource TextMutedBrush}"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14"/>
                                </Grid>
                            </Border>

                            <!-- Search Results Popup -->
                            <Popup IsOpen="{Binding HasSearchResults, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchBorderEditor}" Placement="Bottom" StaysOpen="False" MinWidth="600" AllowsTransparency="True" VerticalOffset="4">
                                <Border Background="{DynamicResource BgSurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Effect="{DynamicResource MaterialDesignElevationShadow3}">
                                    <ListBox ItemsSource="{Binding SearchResults}" Background="Transparent" BorderThickness="0" MaxHeight="250" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource BrandSuccessBrush}" VerticalAlignment="Center" Margin="16,0"/>
                                                    <Button Grid.Column="2" Style="{StaticResource ModernPrimaryButton}" Width="36" Height="36" Padding="0"
                                                            Command="{Binding DataContext.AddProductCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>

                    <!-- Table Header -->
                    <Border Grid.Row="1" Background="{DynamicResource SurfaceHighlightStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="المنتج" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="الكمية" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                            <TextBlock Grid.Column="2" Text="سعر الوحدة" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                            <TextBlock Grid.Column="3" Text="الخصم" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                            <TextBlock Grid.Column="4" Text="الإجمالي" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                            <TextBlock Grid.Column="5" Text="حذف" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13"/>
                        </Grid>
                    </Border>

                    <!-- Table Body -->
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="16,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="3*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="60"/>
                                            </Grid.ColumnDefinitions>
                                            
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Product.Barcode}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </StackPanel>

                                            <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged"
                                                     Style="{StaticResource ModernTextBox}" Padding="6" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            
                                            <TextBox Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged"
                                                     Style="{StaticResource ModernTextBox}" Padding="6" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="4,0"/>
                                            
                                            <TextBox Grid.Column="3" Text="{Binding Discount, UpdateSourceTrigger=PropertyChanged}" TextChanged="TextBox_TextChanged"
                                                     Style="{StaticResource ModernTextBox}" Padding="6" FontSize="14" TextAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                            
                                            <TextBlock Grid.Column="4" Text="{Binding SubTotal, StringFormat={}{0:N2}}"
                                                       FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrandSuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                            
                                            <Button Grid.Column="5" Style="{StaticResource ModernIconButton}" Width="32" Height="32" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource BrandDangerBrush}" ToolTip="حذف"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- ═══ TOTALS & ACTIONS ═══ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="380"/>
                </Grid.ColumnDefinitions>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Content="حفظ التعديلات" Command="{Binding SaveCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Style="{StaticResource ModernSuccessButton}" Width="160" Height="44" Margin="0,0,12,0" FontSize="14"/>
                    <Button Content="إلغاء" Command="{Binding CancelCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                            Style="{StaticResource ModernSecondaryButton}" Width="100" Height="44" FontSize="14"/>
                </StackPanel>

                <!-- Totals Card -->
                <Border Grid.Column="2" Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="المجموع الفرعي:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat={}{0:N2}}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="14"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الضريبة:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="{Binding TaxAmount, StringFormat={}{0:N2}}" Foreground="{DynamicResource BrandWarningBrush}" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="14"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الخصم:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                            <TextBlock Grid.Column="1" Text="{Binding DiscountAmount, StringFormat={}{0:N2}}" Foreground="{DynamicResource BrandDangerBrush}" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="14"/>
                        </Grid>
                        <Separator Background="{DynamicResource DividerBrush}" Margin="0,6,0,12"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="الإجمالي المستحق:" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding GrandTotal, StringFormat={}{0:N2} د.ع}" FontWeight="Bold" Foreground="{DynamicResource BrandAccentBrush}" FontSize="24" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
