<UserControl x:Class="RetailApp.Controls.QuickActionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="Transparent">
             
    <Button Height="100" Margin="8" Padding="0" Background="Transparent" BorderThickness="0"
            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            
        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="24" Background="{DynamicResource BrandInfoTransparentBrush}" Margin="0,0,0,8" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="{Binding Icon}" Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                </Border>
                <TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Button>
</UserControl>
