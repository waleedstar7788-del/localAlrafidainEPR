<UserControl x:Class="RetailApp.Controls.PrintTemplates.ReceiptPreviewTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:RetailApp.Converters"
             Background="White"
             FlowDirection="RightToLeft"
             FontFamily="{Binding Template.FontFamily}">
    <UserControl.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <converters:StringToThicknessConverter x:Key="StringToThicknessConverter"/>
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <converters:BoolToFontStyleConverter x:Key="BoolToFontStyleConverter"/>
        <converters:BoolToTextDecorationConverter x:Key="BoolToTextDecorationConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        
        <Style TargetType="TextBlock" x:Key="BaseTextStyle">
            <Setter Property="Foreground" Value="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}"/>
            <Setter Property="FontSize" Value="{Binding Template.FontSize}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextDecorations" Value="{Binding Template.IsUnderlined, Converter={StaticResource BoolToTextDecorationConverter}}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle" BasedOn="{StaticResource BaseTextStyle}">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="10"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="HeaderTextStyle" BasedOn="{StaticResource BaseTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="{Binding Template.Margins, Converter={StaticResource StringToThicknessConverter}}"
                TextElement.FontWeight="{Binding Template.IsBold, Converter={StaticResource BoolToFontWeightConverter}}"
                TextElement.FontStyle="{Binding Template.IsItalic, Converter={StaticResource BoolToFontStyleConverter}}">
        
        <!-- Logo -->
        <Border Width="{Binding Template.LogoSize}" Height="{Binding Template.LogoSize}" 
                HorizontalAlignment="Center" 
                Visibility="{Binding Template.ShowLogo, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,10">
            <Image Stretch="Uniform">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="{Binding Template.LogoPath}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Template.LogoPath}" Value="">
                                <Setter Property="Source" Value="{Binding GlobalSettings.StoreLogo}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Template.LogoPath}" Value="{x:Null}">
                                <Setter Property="Source" Value="{Binding GlobalSettings.StoreLogo}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
        </Border>
        
        <!-- Company Header Info -->
        <TextBlock Text="{Binding Template.CompanyName}" Margin="0,0,0,4">
            <TextBlock.Style>
                <Style TargetType="TextBlock" BasedOn="{StaticResource HeaderTextStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Template.CompanyName}" Value="">
                            <Setter Property="Text" Value="{Binding GlobalSettings.StoreName}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Template.CompanyName}" Value="{x:Null}">
                            <Setter Property="Text" Value="{Binding GlobalSettings.StoreName}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <TextBlock Text="{Binding Template.HeaderText}" Style="{StaticResource BaseTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,10"/>

        <!-- Contact & Tax Info -->
        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                <TextBlock Text="الرقم الضريبي: " Style="{StaticResource LabelStyle}"/>
                <TextBlock FontSize="10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                            <Setter Property="Text" Value="{Binding Template.CompanyTaxNumber}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Template.CompanyTaxNumber}" Value="">
                                    <Setter Property="Text" Value="{Binding GlobalSettings.TaxNumber}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,2">
                <TextBlock Text="هاتف: " Style="{StaticResource LabelStyle}"/>
                <TextBlock FontSize="10">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                            <Setter Property="Text" Value="{Binding Template.CompanyPhone}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Template.CompanyPhone}" Value="">
                                    <Setter Property="Text" Value="{Binding GlobalSettings.Phone}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </StackPanel>

        <!-- Divider -->
        <Rectangle Height="1" Fill="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" StrokeDashArray="2,2" Margin="0,5,0,15"/>

        <!-- Title -->
        <TextBlock Text="{Binding Template.InvoiceTitle}" Style="{StaticResource HeaderTextStyle}" FontSize="16" Margin="0,0,0,15" TextAlignment="{Binding Template.TextAlignment}"/>

        <!-- Metadata -->
        <Grid Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="رقم الفاتورة:" Style="{StaticResource LabelStyle}" Margin="0,0,10,4"/>
            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <TextBlock Text="{Binding Template.InvoicePrefix}" Style="{StaticResource BaseTextStyle}" FontSize="10"/>
                <TextBlock Text="{Binding Invoice.InvoiceNumber}" Style="{StaticResource BaseTextStyle}" FontSize="10"/>
            </StackPanel>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="التاريخ:" Style="{StaticResource LabelStyle}" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Invoice.InvoiceDate, StringFormat='yyyy/MM/dd HH:mm'}" Style="{StaticResource BaseTextStyle}" FontSize="10" HorizontalAlignment="Right"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="العميل:" Style="{StaticResource LabelStyle}" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Invoice.Customer.FullName}" Style="{StaticResource BaseTextStyle}" FontSize="10" HorizontalAlignment="Right" TextWrapping="Wrap"/>
            
            <TextBlock Grid.Row="3" Grid.Column="0" Text="الكاشير:" Style="{StaticResource LabelStyle}" Margin="0,0,10,4"/>
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Invoice.CashierName}" Style="{StaticResource BaseTextStyle}" FontSize="10" HorizontalAlignment="Right"/>
        </Grid>

        <!-- Divider -->
        <Rectangle Height="1" Fill="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" StrokeDashArray="2,2" Margin="0,0,0,10"/>

        <!-- Items Header -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto" MinWidth="40"/>
                <ColumnDefinition Width="Auto" MinWidth="60"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الصنف" Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Text="الكمية" Style="{StaticResource LabelStyle}" TextAlignment="Center"/>
            <TextBlock Grid.Column="2" Text="المجموع" Style="{StaticResource LabelStyle}" TextAlignment="Left"/>
        </Grid>
        
        <Rectangle Height="1" Fill="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" Margin="0,0,0,8"/>

        <!-- Items List -->
        <ItemsControl ItemsSource="{Binding Invoice.Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto" MinWidth="40"/>
                            <ColumnDefinition Width="Auto" MinWidth="60"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Product.Name}" Style="{StaticResource BaseTextStyle}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding UnitPrice, StringFormat='N0'}" Style="{StaticResource BaseTextStyle}" FontSize="10" Opacity="0.7"/>
                        </StackPanel>
                        
                        <TextBlock Grid.Column="1" Text="{Binding Quantity}" Style="{StaticResource BaseTextStyle}" TextAlignment="Center" VerticalAlignment="Center"/>
                        
                        <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SubTotal, StringFormat='N0'}" Style="{StaticResource BaseTextStyle}" FontWeight="Bold"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Rectangle Height="1" Fill="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" StrokeDashArray="2,2" Margin="0,5,0,15"/>

        <!-- Totals -->
        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="المجموع الفرعي:" Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{Binding Invoice.SubTotal, StringFormat='N0'}" Style="{StaticResource BaseTextStyle}"/>
        </Grid>

        <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الخصم الإضافي:" Style="{StaticResource LabelStyle}"/>
            <TextBlock Grid.Column="1" Text="{Binding Invoice.DiscountAmount, StringFormat='N0'}" Style="{StaticResource BaseTextStyle}"/>
        </Grid>

        <Rectangle Height="1" Fill="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" Margin="0,4,0,10"/>

        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الإجمالي المستحق:" Style="{StaticResource BaseTextStyle}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Text="{Binding Invoice.GrandTotal, StringFormat='N0'}" Style="{StaticResource BaseTextStyle}" FontWeight="Bold" FontSize="18" Margin="0,0,4,0"/>
            <TextBlock Grid.Column="2" Text="{Binding Template.CurrencyDisplay}" Style="{StaticResource BaseTextStyle}" FontSize="12" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
        </Grid>

        <!-- Footer Text -->
        <TextBlock Text="{Binding Template.FooterText}" 
                   Style="{StaticResource BaseTextStyle}" 
                   HorizontalAlignment="Center" 
                   TextAlignment="Center"
                   Opacity="0.8"
                   Visibility="{Binding Template.ShowFooter, Converter={StaticResource BoolToVis}}"
                   Margin="0,0,0,20"/>

        <!-- QR Code Placeholder -->
        <Border Width="80" Height="80" 
                BorderBrush="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="1" Padding="4" CornerRadius="4"
                HorizontalAlignment="Center" 
                Visibility="{Binding Template.ShowQR, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,15">
            <materialDesign:PackIcon Kind="Qrcode" Width="70" Height="70" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}"/>
        </Border>
        
        <!-- Barcode Placeholder -->
        <Border Width="160" Height="40" 
                HorizontalAlignment="Center" 
                Visibility="{Binding Template.ShowBarcode, Converter={StaticResource BoolToVis}}"
                Margin="0,0,0,10">
            <materialDesign:PackIcon Kind="Barcode" Width="160" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}"/>
        </Border>

    </StackPanel>
</UserControl>
