<UserControl x:Class="RetailApp.Controls.PrintTemplates.A4PreviewTemplate"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:RetailApp.Converters"
             Background="White"
             FlowDirection="RightToLeft"
             FontFamily="{Binding Template.FontFamily}">
    <UserControl.Resources>
        <converters:StringToBrushConverter x:Key="StringToBrushConverter"/>
        <converters:StringToThicknessConverter x:Key="StringToThicknessConverter"/>
        <converters:BoolToFontWeightConverter x:Key="BoolToFontWeightConverter"/>
        <converters:BoolToFontStyleConverter x:Key="BoolToFontStyleConverter"/>
        <converters:BoolToTextDecorationConverter x:Key="BoolToTextDecorationConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock" x:Key="BaseTextStyle">
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="{Binding Template.FontSize}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextDecorations" Value="{Binding Template.IsUnderlined, Converter={StaticResource BoolToTextDecorationConverter}}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle" BasedOn="{StaticResource BaseTextStyle}">
            <Setter Property="Foreground" Value="#4B5563"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="ValueStyle" BasedOn="{StaticResource BaseTextStyle}">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        
        <Style TargetType="Border" x:Key="GridCell">
            <Setter Property="BorderBrush" Value="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
            <Setter Property="Padding" Value="8"/>
        </Style>

        <Style TargetType="Border" x:Key="GridRowBottom">
            <Setter Property="BorderBrush" Value="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="{Binding Template.Margins, Converter={StaticResource StringToThicknessConverter}}"
          TextElement.FontWeight="{Binding Template.IsBold, Converter={StaticResource BoolToFontWeightConverter}}"
          TextElement.FontStyle="{Binding Template.IsItalic, Converter={StaticResource BoolToFontStyleConverter}}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="Auto"/> <!-- Metadata & Customer -->
            <RowDefinition Height="*"/>    <!-- Items Table -->
            <RowDefinition Height="Auto"/> <!-- Totals & Notes -->
            <RowDefinition Height="Auto"/> <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 1. Header Section -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Company Info (Right) -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock FontWeight="Bold" FontSize="26" Foreground="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                            <Setter Property="Text" Value="{Binding Template.CompanyName}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Template.CompanyName}" Value="">
                                    <Setter Property="Text" Value="{Binding GlobalSettings.StoreName}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Template.CompanyName}" Value="{x:Null}">
                                    <Setter Property="Text" Value="{Binding GlobalSettings.StoreName}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <TextBlock FontSize="16" Foreground="#4B5563" Margin="0,2,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                            <Setter Property="Text" Value="{Binding Template.CompanyArabicName}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Template.CompanyArabicName}" Value="">
                                    <Setter Property="Text" Value="{Binding GlobalSettings.ArabicName}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Template.CompanyArabicName}" Value="{x:Null}">
                                    <Setter Property="Text" Value="{Binding GlobalSettings.ArabicName}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="الرقم الضريبي:" Style="{StaticResource LabelStyle}" Margin="0,0,0,0"/>
                    <TextBlock Margin="6,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                <Setter Property="Text" Value="{Binding Template.CompanyTaxNumber}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Template.CompanyTaxNumber}" Value="">
                                        <Setter Property="Text" Value="{Binding GlobalSettings.TaxNumber}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <TextBlock Text="س.ت:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                <Setter Property="Text" Value="{Binding Template.CompanyCR}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Template.CompanyCR}" Value="">
                                        <Setter Property="Text" Value="{Binding GlobalSettings.CommercialRegistration}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="هاتف:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Margin="6,0,16,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                <Setter Property="Text" Value="{Binding Template.CompanyPhone}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Template.CompanyPhone}" Value="">
                                        <Setter Property="Text" Value="{Binding GlobalSettings.Phone}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    
                    <TextBlock Text="إيميل:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                <Setter Property="Text" Value="{Binding Template.CompanyEmail}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Template.CompanyEmail}" Value="">
                                        <Setter Property="Text" Value="{Binding GlobalSettings.Email}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="العنوان:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Margin="6,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource BaseTextStyle}">
                                <Setter Property="Text" Value="{Binding Template.CompanyAddress}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Template.CompanyAddress}" Value="">
                                        <Setter Property="Text" Value="{Binding GlobalSettings.Address}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </StackPanel>

            <!-- Logo (Left) -->
            <Border Grid.Column="1" Width="{Binding Template.LogoSize}" Height="{Binding Template.LogoSize}" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="{Binding Template.ShowLogo, Converter={StaticResource BoolToVis}}">
                <Image Stretch="Uniform">
                    <Image.Style>
                        <Style TargetType="Image">
                            <Setter Property="Source" Value="{Binding Template.LogoPath}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Template.LogoPath}" Value="">
                                    <Setter Property="Source" Value="{Binding GlobalSettings.StoreLogo}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Template.LogoPath}" Value="{x:Null}">
                                    <Setter Property="Source" Value="{Binding GlobalSettings.StoreLogo}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Image.Style>
                </Image>
            </Border>
        </Grid>

        <Rectangle Grid.Row="1" Height="2" Fill="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}" Margin="0,0,0,15" VerticalAlignment="Top"/>

        <!-- 2. Invoice Meta & Customer Section -->
        <Grid Grid.Row="1" Margin="0,15,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Customer Details (Right) -->
            <Border Grid.Column="0" BorderBrush="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <StackPanel>
                    <TextBlock Text="فاتورة إلى:" Style="{StaticResource LabelStyle}" Foreground="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}" FontSize="14" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding Invoice.Customer.FullName}" Style="{StaticResource ValueStyle}" FontSize="16" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding Invoice.Customer.Phone}" Style="{StaticResource BaseTextStyle}" Margin="0,0,0,2"/>
                    <TextBlock Text="{Binding Invoice.Customer.Address}" Style="{StaticResource BaseTextStyle}"/>
                </StackPanel>
            </Border>

            <!-- Invoice Details (Left) -->
            <Border Grid.Column="2" BorderBrush="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="1" CornerRadius="4" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="{Binding Template.InvoiceTitle}" FontSize="22" FontWeight="Bold" Foreground="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}" Margin="0,0,0,10" TextAlignment="{Binding Template.TextAlignment}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="رقم الفاتورة:" Style="{StaticResource LabelStyle}" Margin="0,0,16,6"/>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding Template.InvoicePrefix}" Style="{StaticResource ValueStyle}"/>
                        <TextBlock Text="{Binding Invoice.InvoiceNumber}" Style="{StaticResource ValueStyle}"/>
                    </StackPanel>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="التاريخ:" Style="{StaticResource LabelStyle}" Margin="0,0,16,6"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Invoice.InvoiceDate, StringFormat='yyyy/MM/dd HH:mm'}" Style="{StaticResource ValueStyle}" HorizontalAlignment="Right"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="البائع:" Style="{StaticResource LabelStyle}"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Invoice.CashierName}" Style="{StaticResource ValueStyle}" HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 3. Items Table -->
        <Border Grid.Row="2" BorderBrush="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="1" CornerRadius="4" Margin="0,0,0,20" VerticalAlignment="Top">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Table Header -->
                <Border Grid.Row="0" Background="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}" BorderBrush="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource GridCell}">
                            <TextBlock Text="البيان" Foreground="White" FontWeight="Bold" FontSize="13"/>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource GridCell}">
                            <TextBlock Text="الكمية" Foreground="White" FontWeight="Bold" FontSize="13" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource GridCell}">
                            <TextBlock Text="سعر الوحدة" Foreground="White" FontWeight="Bold" FontSize="13" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="3" Style="{StaticResource GridCell}" Visibility="{Binding Template.ShowDiscountColumn, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="الخصم" Foreground="White" FontWeight="Bold" FontSize="13" TextAlignment="Center"/>
                        </Border>
                        <Border Grid.Column="4" Padding="8">
                            <TextBlock Text="الإجمالي" Foreground="White" FontWeight="Bold" FontSize="13" TextAlignment="Left"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Items List -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Invoice.Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource GridRowBottom}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Alternating Background via Trigger (Optional) -->
                                    <Border Grid.ColumnSpan="5" Background="#F8FAFC" Opacity="0.5" Visibility="{Binding DataContext.Template.AlternateRowColors, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <!-- Need an index converter to do real alternating rows, but static looks okay too. Using white by default -->
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <!-- Simplified: no dynamic alternate since it requires an index converter -->
                                            </Style>
                                        </Border.Style>
                                    </Border>

                                    <Border Grid.Column="0" Style="{StaticResource GridCell}">
                                        <TextBlock Text="{Binding Product.Name}" Style="{StaticResource BaseTextStyle}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <Border Grid.Column="1" Style="{StaticResource GridCell}">
                                        <TextBlock Text="{Binding Quantity}" Style="{StaticResource BaseTextStyle}" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <Border Grid.Column="2" Style="{StaticResource GridCell}">
                                        <TextBlock Text="{Binding UnitPrice, StringFormat='N0'}" Style="{StaticResource BaseTextStyle}" TextAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    
                                    <Border Grid.Column="3" Style="{StaticResource GridCell}" Visibility="{Binding DataContext.Template.ShowDiscountColumn, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding DiscountAmount, StringFormat='N0'}" Style="{StaticResource BaseTextStyle}" TextAlignment="Center" VerticalAlignment="Center" Foreground="#EF4444"/>
                                    </Border>
                                    
                                    <Border Grid.Column="4" Padding="8">
                                        <TextBlock Text="{Binding SubTotal, StringFormat='N0'}" Style="{StaticResource BaseTextStyle}" FontWeight="Bold" TextAlignment="Left" VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <!-- 4. Totals & Notes Section -->
        <Grid Grid.Row="3" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Notes / Thanks text -->
            <StackPanel Grid.Column="0" VerticalAlignment="Top" Margin="0,0,20,0">
                <TextBlock Text="ملاحظات:" Style="{StaticResource LabelStyle}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding Template.HeaderText}" Style="{StaticResource BaseTextStyle}" Foreground="#4B5563" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Totals Table -->
            <Border Grid.Column="1" BorderBrush="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource GridRowBottom}">
                        <Grid Margin="12,8">
                            <TextBlock Text="المجموع الفرعي:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Invoice.SubTotal, StringFormat='N0'}" Style="{StaticResource ValueStyle}" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource GridRowBottom}">
                        <Grid Margin="12,8">
                            <TextBlock Text="الخصم الإضافي:" Style="{StaticResource LabelStyle}" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding Invoice.DiscountAmount, StringFormat='N0'}" Style="{StaticResource ValueStyle}" Foreground="#EF4444" HorizontalAlignment="Left" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Add Tax Row if needed in the future -->

                    <Border Grid.Row="3" Grid.ColumnSpan="2" Background="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}">
                        <Grid Margin="12,12">
                            <TextBlock Text="الإجمالي المستحق:" Foreground="White" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Invoice.GrandTotal, StringFormat='N0'}" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,0,8,0"/>
                                <TextBlock Text="{Binding Template.CurrencyDisplay}" Foreground="White" FontSize="14" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- 5. Footer Section -->
        <Grid Grid.Row="4" VerticalAlignment="Bottom" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="80" Height="80" BorderBrush="{Binding Template.BorderColor, Converter={StaticResource StringToBrushConverter}}" BorderThickness="1" Padding="4" CornerRadius="4" Visibility="{Binding Template.ShowQR, Converter={StaticResource BoolToVis}}">
                <materialDesign:PackIcon Kind="Qrcode" Width="70" Height="70" Foreground="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20,0">
                <TextBlock Text="{Binding Template.FooterText}" Style="{StaticResource BaseTextStyle}" Foreground="#64748B" TextAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,8"/>
                
                <!-- Barcode -->
                <Border Height="40" Width="200" Visibility="{Binding Template.ShowBarcode, Converter={StaticResource BoolToVis}}">
                    <materialDesign:PackIcon Kind="Barcode" Width="190" Height="36" Foreground="{Binding Template.PrimaryColor, Converter={StaticResource StringToBrushConverter}}" HorizontalAlignment="Center"/>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
