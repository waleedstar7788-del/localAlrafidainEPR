<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ─── CALM NEUMORPHIC / GLASS PEARL PALETTE (NEUMORPHIC LUXURY) ─── -->
    <Color x:Key="PrimaryColor">#1E3A5F</Color>         <!-- Deep Sapphire Blue -->
    <Color x:Key="AccentColor">#2A4365</Color>          <!-- Subdued Ocean Blue -->
    <Color x:Key="PrimaryLightColor">#2B6CB0</Color>     <!-- Soft Muted Blue -->
    <Color x:Key="PrimaryDarkColor">#1A202C</Color>      <!-- Rich Slate Navy -->

    <!-- Semantic Colors (Warm & Subdued - Non-Neon) -->
    <Color x:Key="SuccessColor">#2B6CB0</Color>        <!-- Deep Sapphire -->
    <Color x:Key="WarningColor">#C05621</Color>        <!-- Warm Terracotta -->
    <Color x:Key="DangerColor">#9B2C2C</Color>         <!-- Subdued Crimson -->
    <Color x:Key="InfoColor">#B7791F</Color>           <!-- Muted Sand Gold -->

    <!-- Neumorphic Surfaces (Pearl-White Soft Depth) -->
    <Color x:Key="BgBaseColor">#EBF0F5</Color>          <!-- Neumorphic Pearl Base -->
    <Color x:Key="BgSurfaceColor">#E2E8F0</Color>       <!-- Soft Pearl Surface -->
    <Color x:Key="BgCardColor">#F4F7FA</Color>          <!-- Neumorphic Tactile Card -->
    <Color x:Key="BgElevatedColor">#FFFFFF</Color>      <!-- Raised Pure Surface -->
    <Color x:Key="BorderColor">#D2DCE6</Color>          <!-- Soft Pearl Contour -->
    <Color x:Key="BorderLightColor">#E2E8F0</Color>     <!-- Subdued Light Border -->

    <!-- Typography Palette (Refined Charcoal) -->
    <Color x:Key="TextPrimaryColor">#1A202C</Color>     <!-- Deep Charcoal Text -->
    <Color x:Key="TextSecondaryColor">#4A5568</Color>   <!-- Muted Slate Text -->
    <Color x:Key="TextMutedColor">#718096</Color>       <!-- Subtle Gray Text -->

    <!-- ─── SOLID COLOR BRUSHES ─── -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{DynamicResource PrimaryDarkColor}" />

    <SolidColorBrush x:Key="BrandSuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="BrandWarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="BrandDangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="BrandInfoBrush" Color="{DynamicResource InfoColor}" />

    <SolidColorBrush x:Key="BgBaseBrush" Color="{DynamicResource BgBaseColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{DynamicResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{DynamicResource BgCardColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{DynamicResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{DynamicResource BorderLightColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />

    <!-- ─── STRUCTURAL & SIDEBAR BRUSHES ─── -->
    <!-- Solid Deep Matte Navy Sidebar (#1B2A4A -> #142038) -->
    <LinearGradientBrush x:Key="SidebarBackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1B2A4A" Offset="0"/>
        <GradientStop Color="#142038" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="TopBarBackgroundBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#EBF0F5" Offset="0"/>
        <GradientStop Color="#E2E8F0" Offset="1"/>
    </LinearGradientBrush>

    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#0D000000" />
    <SolidColorBrush x:Key="SurfaceHighlightStrongBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="DividerBrush" Color="#CBD5E0" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#66EBF0F5" />

    <SolidColorBrush x:Key="BrandPrimaryTransparentBrush" Color="#151E3A5F" />
    <SolidColorBrush x:Key="BrandSuccessTransparentBrush" Color="#152B6CB0" />
    <SolidColorBrush x:Key="BrandWarningTransparentBrush" Color="#15C05621" />
    <SolidColorBrush x:Key="BrandDangerTransparentBrush" Color="#159B2C2C" />
    <SolidColorBrush x:Key="BrandInfoTransparentBrush" Color="#15B7791F" />

    <!-- LEGACY COMPATIBILITY ALIASES -->
    <SolidColorBrush x:Key="BrandDarkNavyBrush" Color="{DynamicResource BgBaseColor}" />
    <SolidColorBrush x:Key="BrandDarkNavyLightBrush" Color="{DynamicResource BgCardColor}" />
    <SolidColorBrush x:Key="BrandModernBlueBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="BrandEmeraldGreenBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="BrandOrangeBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="BrandRedBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="BrandWhiteBrush" Color="{DynamicResource TextPrimaryColor}" />

</ResourceDictionary>
