<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ─── CYBER OBSIDIAN COLOR PALETTE (DARK MODE) ─── -->
    <Color x:Key="PrimaryColor">#10B981</Color>         <!-- Neon Emerald -->
    <Color x:Key="AccentColor">#06B6D4</Color>          <!-- Glowing Cyan -->
    <Color x:Key="PrimaryLightColor">#34D399</Color>     <!-- Vibrant Mint -->
    <Color x:Key="PrimaryDarkColor">#059669</Color>      <!-- Deep Emerald -->

    <!-- Semantic Colors -->
    <Color x:Key="SuccessColor">#10B981</Color>
    <Color x:Key="WarningColor">#F59E0B</Color>
    <Color x:Key="DangerColor">#EF4444</Color>
    <Color x:Key="InfoColor">#3B82F6</Color>

    <!-- Glass & Surface Palette (Cyber Slate) -->
    <Color x:Key="BgBaseColor">#090D16</Color>          <!-- Deep Night Base -->
    <Color x:Key="BgSurfaceColor">#111827</Color>       <!-- Glass Slate -->
    <Color x:Key="BgCardColor">#1F293D</Color>          <!-- Elevated Card -->
    <Color x:Key="BgElevatedColor">#2A364F</Color>      <!-- High Contrast Surface -->
    <Color x:Key="BorderColor">#374151</Color>          <!-- Border Neutral -->
    <Color x:Key="BorderLightColor">#1F2937</Color>     <!-- Subdued Border -->

    <!-- Typography Palette -->
    <Color x:Key="TextPrimaryColor">#F9FAFB</Color>     <!-- High Contrast Pure White -->
    <Color x:Key="TextSecondaryColor">#E2E8F0</Color>   <!-- Soft Slate -->
    <Color x:Key="TextMutedColor">#94A3B8</Color>       <!-- Subtle Gray -->

    <!-- ─── SOLID COLOR BRUSHES ─── -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{DynamicResource PrimaryColor}" />
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{DynamicResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{DynamicResource PrimaryDarkColor}" />

    <SolidColorBrush x:Key="BrandSuccessBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="BrandWarningBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="BrandDangerBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="BrandInfoBrush" Color="{DynamicResource InfoColor}" />

    <SolidColorBrush x:Key="BgBaseBrush" Color="{DynamicResource BgBaseColor}" />
    <SolidColorBrush x:Key="BgSurfaceBrush" Color="{DynamicResource BgSurfaceColor}" />
    <SolidColorBrush x:Key="BgCardBrush" Color="{DynamicResource BgCardColor}" />
    <SolidColorBrush x:Key="BgElevatedBrush" Color="{DynamicResource BgElevatedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{DynamicResource BorderColor}" />
    <SolidColorBrush x:Key="BorderLightBrush" Color="{DynamicResource BorderLightColor}" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="{DynamicResource TextMutedColor}" />

    <!-- ─── GLASSMORPHIC & GLOW EFFECTS ─── -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#0D1322" />
    <SolidColorBrush x:Key="TopBarBackgroundBrush" Color="#111827" />

    <SolidColorBrush x:Key="SurfaceHighlightBrush" Color="#0DFFFFFF" />
    <SolidColorBrush x:Key="SurfaceHighlightStrongBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#1E293B" />
    <SolidColorBrush x:Key="OverlayBackgroundBrush" Color="#CC090D16" />

    <SolidColorBrush x:Key="BrandPrimaryTransparentBrush" Color="#2010B981" />
    <SolidColorBrush x:Key="BrandSuccessTransparentBrush" Color="#2010B981" />
    <SolidColorBrush x:Key="BrandWarningTransparentBrush" Color="#20F59E0B" />
    <SolidColorBrush x:Key="BrandDangerTransparentBrush" Color="#20EF4444" />
    <SolidColorBrush x:Key="BrandInfoTransparentBrush" Color="#203B82F6" />

    <!-- LEGACY COMPATIBILITY ALIASES -->
    <SolidColorBrush x:Key="BrandDarkNavyBrush" Color="{DynamicResource BgBaseColor}" />
    <SolidColorBrush x:Key="BrandDarkNavyLightBrush" Color="{DynamicResource BgCardColor}" />
    <SolidColorBrush x:Key="BrandModernBlueBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="BrandEmeraldGreenBrush" Color="{DynamicResource SuccessColor}" />
    <SolidColorBrush x:Key="BrandOrangeBrush" Color="{DynamicResource WarningColor}" />
    <SolidColorBrush x:Key="BrandRedBrush" Color="{DynamicResource DangerColor}" />
    <SolidColorBrush x:Key="BrandWhiteBrush" Color="{DynamicResource TextPrimaryColor}" />

</ResourceDictionary>
