<UserControl x:Class="RetailApp.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RetailApp.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar: Title & Invoice Info -->
            <RowDefinition Height="*"/>    <!-- Main Area: Table & Totals -->
        </Grid.RowDefinitions>

        <!-- ═══ TOP BAR (HEADER & INVOICE INFO COMBINED) ═══ -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Title -->
                    <ColumnDefinition Width="*"/>    <!-- Spacer -->
                    <ColumnDefinition Width="2.5*"/> <!-- Customer Select -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/> <!-- Invoice No -->
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="1.2*"/> <!-- Cashier -->
                </Grid.ColumnDefinitions>

                <!-- Title & Icon -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                    <materialDesign:PackIcon Kind="ReceiptText" Foreground="{DynamicResource BrandPrimaryBrush}" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="إنشاء فاتورة مبيعات" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Customer Selection -->
                <Grid Grid.Column="2" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0" ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" DisplayMemberPath="FullName" 
                              Style="{StaticResource ModernComboBox}" materialDesign:HintAssist.Hint="اختر العميل" FontSize="13.5"/>
                    <Button Grid.Column="1" Style="{StaticResource ModernSecondaryButton}" Width="36" Height="36" Margin="8,0,0,0" ToolTip="عميل جديد" Command="{Binding AddNewCustomerCommand}">
                        <materialDesign:PackIcon Kind="AccountPlusOutline" Foreground="{DynamicResource BrandPrimaryBrush}" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <!-- Invoice Number -->
                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                    <TextBox Text="{Binding CurrentInvoice.InvoiceNumber, Mode=OneWay}" IsReadOnly="True" FontSize="13.5" FontWeight="SemiBold"
                             Style="{StaticResource ModernTextBox}" materialDesign:HintAssist.Hint="رقم الفاتورة"/>
                </StackPanel>

                <!-- Cashier -->
                <StackPanel Grid.Column="6" VerticalAlignment="Center">
                    <TextBox Text="{Binding CurrentInvoice.Cashier, Mode=OneWay}" IsReadOnly="True" FontSize="13.5"
                             Style="{StaticResource ModernTextBox}" materialDesign:HintAssist.Hint="الكاشير"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══ MAIN WORK AREA ═══ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="360"/>
            </Grid.ColumnDefinitions>

            <!-- RIGHT SIDE: SEARCH & TABLE (Stretches Full Height) -->
            <Border Grid.Column="0" Style="{StaticResource KpiCard}" Padding="0" ClipToBounds="True" Margin="0,0,12,0" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Search Bar -->
                        <RowDefinition Height="*"/>    <!-- Items Table -->
                        <RowDefinition Height="Auto"/> <!-- Bottom Actions -->
                    </Grid.RowDefinitions>
                    
                    <!-- Search & Add Item Bar -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <Border x:Name="SearchBorder" Grid.Column="0" Style="{StaticResource SearchBarBorder}" Background="{DynamicResource BgCardBrush}" HorizontalAlignment="Stretch" Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="12,0,8,0" Width="18" Height="18"/>
                                    <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                             materialDesign:HintAssist.Hint="ابحث عن منتج بالاسم أو امسح الباركود واضغط Enter..."
                                             materialDesign:HintAssist.Foreground="{DynamicResource TextMutedBrush}"
                                             materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                             Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="14">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                        </TextBox.InputBindings>
                                    </TextBox>
                                </Grid>
                            </Border>
                            
                            <!-- Search Results Popup -->
                            <Popup IsOpen="{Binding HasSearchResults, Mode=OneWay}" PlacementTarget="{Binding ElementName=SearchBorder}" Placement="Bottom" StaysOpen="False" MinWidth="500" AllowsTransparency="True" VerticalOffset="4">
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Effect="{DynamicResource MaterialDesignElevationShadow3}">
                                    <ListBox ItemsSource="{Binding Products}" Background="Transparent" BorderThickness="0" MaxHeight="300" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="8,4" Width="480">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Barcode}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Price, StringFormat={}{0:N2} د.ع}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="16,0,16,0"/>
                                                    <Button Grid.Column="2" Style="{StaticResource ModernPrimaryButton}" Width="36" Height="36" Padding="0" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Plus" Width="18" Height="18"/>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </Popup>
                            
                            <Button Grid.Column="1" Style="{StaticResource ModernPrimaryButton}" Command="{Binding SearchCommand}" Height="42" Padding="16,0">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" Margin="0,0,6,0"/>
                                    <TextBlock Text="إضافة" FontSize="13.5" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                    
                    <!-- Table Grid (Header + Scrollable Items) -->
                    <Grid Grid.Row="1" Margin="16,12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Table Header -->
                        <Border Grid.Row="0" Background="{DynamicResource SurfaceHighlightStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,10" CornerRadius="8,8,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.2*"/>
                                    <ColumnDefinition Width="1.5*"/>
                                    <ColumnDefinition Width="2.5*"/>
                                    <ColumnDefinition Width="1.8*"/>
                                    <ColumnDefinition Width="50"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="المنتج" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13.5"/>
                                <TextBlock Grid.Column="1" Text="الكمية" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13.5"/>
                                <TextBlock Grid.Column="2" Text="سعر الوحدة" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13.5"/>
                                <TextBlock Grid.Column="3" Text="ملاحظات" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13.5"/>
                                <TextBlock Grid.Column="4" Text="الإجمالي" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13.5"/>
                                <TextBlock Grid.Column="5" Text="حذف" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Border>
                        
                        <!-- Table Items Body -->
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl ItemsSource="{Binding CurrentInvoice.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="12,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2.5*"/>
                                                    <ColumnDefinition Width="1.2*"/>
                                                    <ColumnDefinition Width="1.5*"/>
                                                    <ColumnDefinition Width="2.5*"/>
                                                    <ColumnDefinition Width="1.8*"/>
                                                    <ColumnDefinition Width="50"/>
                                                </Grid.ColumnDefinitions>
                                                
                                                <!-- Product Info -->
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Product.Barcode}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                                
                                                <!-- Quantity Input -->
                                                <TextBox Grid.Column="1" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource ModernTextBox}" Padding="6" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
                                                         
                                                <!-- Unit Price Input -->
                                                <TextBox Grid.Column="2" Text="{Binding UnitPrice, StringFormat={}{0:N2}, UpdateSourceTrigger=PropertyChanged}" 
                                                         Style="{StaticResource ModernTextBox}" Padding="6" FontSize="14" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="4,0"/>
                                                         
                                                <!-- Notes Input -->
                                                <TextBox Grid.Column="3" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                                                         materialDesign:HintAssist.Hint="ملاحظات..." Style="{StaticResource ModernTextBox}" Padding="6" FontSize="13" VerticalAlignment="Center" Margin="4,0"/>
                                                         
                                                <!-- Line Total -->
                                                <TextBlock Grid.Column="4" Text="{Binding Total, StringFormat={}{0:N2} د.ع}" 
                                                           FontWeight="Bold" FontSize="14.5" Foreground="{DynamicResource BrandSuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                                           
                                                <!-- Delete Button -->
                                                <Button Grid.Column="5" Style="{StaticResource ModernIconButton}" Width="34" Height="34" Padding="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        ToolTip="إزالة" Foreground="{DynamicResource BrandDangerBrush}"
                                                        Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="TrashCanOutline" Width="18" Height="18"/>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    
                    <!-- Table Bottom Bar (Cancel / Hold) -->
                    <Border Grid.Row="2" Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Button Content="إلغاء الفاتورة" Command="{Binding ClearCartCommand}" 
                                    Style="{StaticResource ModernWarningButton}" Width="140" Height="40" Margin="0,0,12,0" FontSize="14"/>
                            <Button Content="تجميد (Hold)" Command="{Binding ShortcutHoldCommand}" 
                                    Style="{StaticResource ModernSecondaryButton}" Width="140" Height="40" FontSize="14"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- LEFT SIDE: TOTALS & PAY PANEL (Stretches Full Height) -->
            <Border Grid.Column="1" Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="20" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title Header -->
                        <RowDefinition Height="*"/>    <!-- Subtotals & Details -->
                        <RowDefinition Height="Auto"/> <!-- Grand Total & Pay Button -->
                    </Grid.RowDefinitions>

                    <!-- Section Title -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <TextBlock Text="ملخص الفاتورة" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Separator Background="{DynamicResource DividerBrush}" Margin="0,8,0,0"/>
                    </StackPanel>

                    <!-- Subtotals Breakdown -->
                    <StackPanel Grid.Row="1" VerticalAlignment="Top">
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="المجموع الفرعي" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                            <TextBlock Text="{Binding CurrentInvoice.SubTotal, StringFormat={}{0:N2}}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14.5"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="الضريبة (15%)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                            <TextBlock Text="{Binding CurrentInvoice.Tax, StringFormat={}{0:N2}}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14.5"/>
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="إجمالي الخصم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14"/>
                            <TextBlock Text="{Binding CurrentInvoice.Discount, StringFormat={}{0:N2}}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14.5"/>
                        </Grid>
                    </StackPanel>

                    <!-- Bottom Area (Grand Total + Button) -->
                    <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                        <Separator Background="{DynamicResource DividerBrush}" Margin="0,0,0,16"/>
                        
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="الإجمالي المستحق" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <TextBlock Text="{Binding CurrentInvoice.GrandTotal, StringFormat={}{0:N2} د.ع}" 
                                       Foreground="{DynamicResource BrandAccentBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Left" TextWrapping="Wrap"/>
                        </StackPanel>
                        
                        <Button Command="{Binding ShortcutCompleteCommand}" Height="52"
                                Style="{StaticResource ModernPrimaryButton}"
                                materialDesign:ButtonAssist.CornerRadius="10">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashRegister" Margin="0,0,10,0" Width="22" Height="22"/>
                                <TextBlock Text="دفع وإصدار الفاتورة" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
