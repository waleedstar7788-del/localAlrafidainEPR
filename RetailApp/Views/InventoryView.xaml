<UserControl x:Class="RetailApp.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RetailApp.Controls">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="10">
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource BgBaseColor}" Opacity="0.75"/>
            </Grid.Background>
            <Border Style="{StaticResource KpiCard}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="40,32">
                <StackPanel>
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" 
                                 Width="48" Height="48" HorizontalAlignment="Center" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                    <TextBlock Text="جاري تحميل المنتجات..." Margin="0,20,0,0" FontWeight="SemiBold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Product Editor Modal Overlay -->
        <Grid Visibility="{Binding IsEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="20">
            <Grid.Background>
                <SolidColorBrush Color="{DynamicResource BgBaseColor}" Opacity="0.85"/>
            </Grid.Background>
            <Border Style="{StaticResource DialogContainer}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="800" Margin="20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.6" Color="Black"/>
                </Border.Effect>
                <controls:ProductEditorFormControl DataContext="{Binding EditorViewModel}"/>
            </Border>
        </Grid>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Search/Actions -->
                <RowDefinition Height="*"/>     <!-- DataGrid -->
            </Grid.RowDefinitions>

            <!-- ═══ PAGE HEADER ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="إدارة المخزون والمنتجات" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="إدارة الأصناف، تتبع الكميات، وتحديث الأسعار" FontSize="13" 
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ═══ SEARCH & ACTIONS BAR ═══ -->
            <Grid Grid.Row="1" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource SearchBarBorder}" HorizontalAlignment="Right" Width="400">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0,10,0" Width="18" Height="18"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="بحث عن طريق الباركود، الاسم، أو الفئة..."
                                 materialDesign:HintAssist.Foreground="{DynamicResource TextMutedBrush}"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13"/>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource ModernSecondaryButton}" Margin="0,0,12,0" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="FilterVariant" Margin="0,0,8,0" Width="18" Height="18"/>
                            <TextBlock Text="تصفية" FontSize="13"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding OpenEditorCommand}" Padding="18,10" Height="40">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0" Width="18" Height="18"/>
                            <TextBlock Text="إضافة منتج" FontSize="13"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ═══ DATA TABLE ═══ -->
            <Border Grid.Row="2" Style="{StaticResource KpiCard}" Padding="0" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Products}" AutoGenerateColumns="False" IsReadOnly="True"
                          Style="{StaticResource ModernDataGrid}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="80"/>
                        
                        <DataGridTemplateColumn Header="المنتج" Width="2*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="{DynamicResource SurfaceHighlightStrongBrush}" CornerRadius="8" Width="42" Height="42" Margin="0,0,14,0">
                                            <materialDesign:PackIcon Kind="PackageVariantClosed" Foreground="{DynamicResource TextMutedBrush}" 
                                                                     HorizontalAlignment="Center" VerticalAlignment="Center" Width="22" Height="22"/>
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Barcode}" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        
                        <DataGridTextColumn Header="الفئة" Binding="{Binding Category}" Width="1.5*"/>
                        <DataGridTextColumn Header="السعر" Binding="{Binding SellingPrice, StringFormat={}{0:N2}}" Width="1*"/>
                        <DataGridTextColumn Header="المخزون" Binding="{Binding CurrentQuantity}" Width="1*"/>
                        
                        <DataGridTemplateColumn Header="الحالة" Width="1.5*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource BadgeSuccess}">
                                        <TextBlock Text="متوفر" Foreground="{DynamicResource BrandSuccessBrush}" FontWeight="SemiBold" FontSize="11"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="إجراءات" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="تعديل"
                                                Foreground="{DynamicResource BrandAccentBrush}"
                                                Command="{Binding DataContext.OpenEditorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                        </Button>
                                        <Button Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="حذف"
                                                Foreground="{DynamicResource BrandDangerBrush}" Margin="4,0"
                                                Command="{Binding DataContext.DeleteProductCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16"/>
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
