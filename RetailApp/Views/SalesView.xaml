<UserControl x:Class="RetailApp.Views.SalesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:RetailApp.Converters">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ MAIN LIST (LEFT SIDE) ═══ -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Header -->
                <RowDefinition Height="Auto"/>  <!-- Stats -->
                <RowDefinition Height="Auto"/>  <!-- Search/Actions -->
                <RowDefinition Height="*"/>     <!-- Invoices -->
            </Grid.RowDefinitions>

            <!-- ═══ PAGE HEADER ═══ -->
            <Grid Grid.Row="0" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="فواتير المبيعات" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="استعراض وإدارة وتعديل جميع فواتير المبيعات" FontSize="13" 
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <!-- ═══ KPI STATS ROW ═══ -->
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="CashRegister" Foreground="{DynamicResource BrandInfoBrush}" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="مبيعات اليوم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodaySalesTotal, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="CalendarMonth" Foreground="{DynamicResource BrandSuccessBrush}" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="مبيعات الشهر" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MonthlySalesTotal, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandSuccessBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="TrendingUp" Foreground="{DynamicResource BrandWarningBrush}" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="أرباح اليوم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="{Binding TodayProfit, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandWarningBrush}"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="6" Style="{StaticResource KpiCard}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <materialDesign:PackIcon Kind="ChartLine" Foreground="{DynamicResource BrandSuccessBrush}" Width="20" Height="20" Margin="0,0,8,0"/>
                            <TextBlock Text="أرباح الشهر" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MonthlyProfit, StringFormat={}{0:N2}}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource BrandSuccessBrush}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ═══ SEARCH BAR ═══ -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <Border Style="{StaticResource SearchBarBorder}" HorizontalAlignment="Right" Width="420">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="14,0,10,0" Width="18" Height="18"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" 
                                 materialDesign:HintAssist.Hint="ابحث برقم الفاتورة، العميل، الكاشير..."
                                 materialDesign:HintAssist.Foreground="{DynamicResource TextMutedBrush}"
                                 materialDesign:TextFieldAssist.DecorationVisibility="Hidden"
                                 Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Background="Transparent" VerticalAlignment="Center" FontSize="13"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- ═══ INVOICES TABLE ═══ -->
            <Border Grid.Row="3" Style="{StaticResource KpiCard}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Table Header -->
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceHighlightStrongBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="20,12" CornerRadius="16,16,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.8*"/>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.5*"/>
                                <ColumnDefinition Width="1*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="رقم الفاتورة" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Grid.Column="1" Text="التاريخ" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="العميل" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="الحالة" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="4" Text="الإجمالي" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="5" Text="الربح" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="6" Text="إجراءات" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" HorizontalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Table Body -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Invoices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="20,14" Cursor="Hand">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceHighlightBrush}"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.8*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.5*"/>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>

                                            <!-- Invoice Number -->
                                            <TextBlock Grid.Column="0" Text="{Binding InvoiceNumber}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Date -->
                                            <TextBlock Grid.Column="1" Text="{Binding InvoiceDate, StringFormat={}{0:dd/MM/yyyy}}" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <!-- Customer -->
                                            <TextBlock Grid.Column="2" Text="{Binding Customer.FullName, TargetNullValue='عميل نقدي'}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="3" HorizontalAlignment="Center" VerticalAlignment="Center" CornerRadius="8" Padding="10,4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource BrandSuccessTransparentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                <Setter Property="Background" Value="{DynamicResource BrandDangerTransparentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Unpaid">
                                                                <Setter Property="Background" Value="{DynamicResource BrandWarningTransparentBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                                <Setter Property="Background" Value="{DynamicResource BrandInfoTransparentBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontWeight="SemiBold" FontSize="11">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource BrandSuccessBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrandDangerBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Unpaid">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrandWarningBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                                    <Setter Property="Foreground" Value="{DynamicResource BrandInfoBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>

                                            <!-- Grand Total -->
                                            <TextBlock Grid.Column="4" Text="{Binding GrandTotal, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <!-- Net Profit -->
                                            <TextBlock Grid.Column="5" Text="{Binding NetProfit, StringFormat={}{0:N2}}" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource BrandSuccessBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                            <!-- Actions -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="عرض التفاصيل"
                                                        Command="{Binding DataContext.ViewInvoiceDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Eye" Width="16" Height="16" Foreground="{DynamicResource BrandInfoBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="تعديل الفاتورة" Margin="4,0"
                                                        Command="{Binding DataContext.EditInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" Foreground="{DynamicResource BrandWarningBrush}"/>
                                                </Button>
                                                <Button Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="طباعة"
                                                        Command="{Binding DataContext.PrintInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Printer" Width="16" Height="16"/>
                                                </Button>
                                                <Button Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="إلغاء" Margin="4,0"
                                                        Foreground="{DynamicResource BrandDangerBrush}"
                                                        Command="{Binding DataContext.CancelInvoiceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                                    <materialDesign:PackIcon Kind="Cancel" Width="16" Height="16"/>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Pagination -->
                    <Border Grid.Row="2" Style="{StaticResource PaginationBorder}" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Button Command="{Binding PreviousPageCommand}" Style="{StaticResource ModernIconButton}" Width="32" Height="32">
                                <materialDesign:PackIcon Kind="ChevronRight" Width="18" Height="18"/>
                            </Button>
                            <TextBlock Text="{Binding CurrentPage, StringFormat=صفحة {0}}" 
                                       VerticalAlignment="Center" Margin="16,0" 
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="13"/>
                            <Button Command="{Binding NextPageCommand}" Style="{StaticResource ModernIconButton}" Width="32" Height="32">
                                <materialDesign:PackIcon Kind="ChevronLeft" Width="18" Height="18"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══ DETAIL PANEL (RIGHT SIDE) ═══ -->
        <Border Grid.Column="1" Width="380" Margin="20,0,0,0"
                Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="24"
                Visibility="{Binding SelectedInvoice, Converter={StaticResource NullToVisibilityConverter}, FallbackValue=Collapsed}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Detail Header -->
                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <StackPanel>
                        <TextBlock Text="تفاصيل الفاتورة" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding SelectedInvoice.InvoiceNumber}" Foreground="{DynamicResource BrandInfoBrush}" FontSize="13" FontWeight="SemiBold" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource ModernIconButton}" Width="28" Height="28"
                            Command="{Binding CloseDetailsCommand}">
                        <materialDesign:PackIcon Kind="Close" Width="16" Height="16"/>
                    </Button>
                </Grid>

                <!-- Info Cards -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20">
                    <Border Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="العميل" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedInvoice.Customer.FullName, TargetNullValue='عميل نقدي'}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="الكاشير" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedInvoice.CashierName}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="10" Padding="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="التاريخ" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedInvoice.InvoiceDate, StringFormat={}{0:dd/MM/yyyy}}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="طريقة الدفع" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4"/>
                                <TextBlock Text="{Binding SelectedInvoice.PaymentMethod}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Items List -->
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="المنتجات" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,10"/>
                        <ItemsControl ItemsSource="{Binding SelectedInvoice.Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <TextBlock Text="{Binding Quantity, StringFormat=الكمية: {0}}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,12,0"/>
                                                    <TextBlock Text="{Binding UnitPrice, StringFormat=× {0:N2}}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding SubTotal, StringFormat={}{0:N2}}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource BrandSuccessBrush}" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- Totals -->
                <Border Grid.Row="3" Background="{DynamicResource BgElevatedBrush}" CornerRadius="12" Padding="16">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="المجموع الفرعي" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding SelectedInvoice.SubTotal, StringFormat={}{0:N2}}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="13"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="الضريبة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"/>
                            <TextBlock Text="{Binding SelectedInvoice.TaxAmount, StringFormat={}{0:N2}}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Left" FontWeight="SemiBold" FontSize="13"/>
                        </Grid>
                        <Separator Background="{DynamicResource DividerBrush}" Margin="0,4,0,8"/>
                        <Grid>
                            <TextBlock Text="الإجمالي" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="16"/>
                            <TextBlock Text="{Binding SelectedInvoice.GrandTotal, StringFormat={}{0:N2} د.ع}" FontWeight="Bold" Foreground="{DynamicResource BrandAccentBrush}" FontSize="20" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
