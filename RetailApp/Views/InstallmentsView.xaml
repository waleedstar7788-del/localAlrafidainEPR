<UserControl x:Class="RetailApp.Views.InstallmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Stats -->
            <RowDefinition Height="Auto"/>  <!-- Actions -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ═══ PAGE HEADER ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="إدارة الأقساط" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="متابعة عقود التقسيط، التحصيلات، والديون المتأخرة" FontSize="13" 
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═══ KPI STATS ROW ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="إجمالي الديون المعلقة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TotalOutstandingDebt, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="تحصيلات اليوم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TodaysCollections, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="تحصيلات الشهر" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding MonthlyCollections, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandSuccessBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Style="{StaticResource KpiCard}" BorderBrush="{DynamicResource BrandDangerBrush}" BorderThickness="1,0,0,0">
                <StackPanel>
                    <TextBlock Text="الأقساط المتأخرة" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding LateInstallmentsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandDangerBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ ACTIONS BAR ═══ -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Command="{Binding ShowNewContractDialogCommand}" Style="{StaticResource ModernPrimaryButton}" Padding="18,10" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Margin="0,0,8,0" Width="18" Height="18"/>
                        <TextBlock Text="عقد تقسيط جديد" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ DATA TABLE ═══ -->
        <Border Grid.Row="3" Style="{StaticResource KpiCard}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Contracts}" SelectedItem="{Binding SelectedContract}" AutoGenerateColumns="False" 
                      IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="رقم العقد" Binding="{Binding ContractNumber}" Width="*"/>
                    <DataGridTextColumn Header="العميل" Binding="{Binding Customer.FullName}" Width="1.5*"/>
                    <DataGridTextColumn Header="تاريخ العقد" Binding="{Binding ContractDate, StringFormat={}{0:yyyy-MM-dd}}" Width="*"/>
                    <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalAmount, StringFormat={}{0:N2}}" Width="*"/>
                    <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingAmount, StringFormat={}{0:N2}}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrandDangerBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="الأقساط" Binding="{Binding NumberOfInstallments}" Width="*"/>
                    
                    <DataGridTemplateColumn Header="الحالة" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgeInfo}">
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrandInfoBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="إجراءات" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="عرض التفاصيل">
                                        <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                    </Button>
                                    <Button Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="تسديد قسط"
                                            Foreground="{DynamicResource BrandSuccessBrush}" Margin="4,0">
                                        <materialDesign:PackIcon Kind="CashPlus" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
