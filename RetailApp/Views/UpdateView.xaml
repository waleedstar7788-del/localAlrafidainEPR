<UserControl x:Class="RetailApp.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════════
             1. HERO HEADER BANNER (CYBER OBSIDIAN GLASS)
        ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0" Margin="0,0,0,24" CornerRadius="18" Padding="32,24" BorderBrush="#334155" BorderThickness="1">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0B0F19" Offset="0"/>
                    <GradientStop Color="#1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Border Background="#2010B981" BorderBrush="#3010B981" BorderThickness="1" CornerRadius="8" Padding="10,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مركز التحديثات والترقية الفورية المباشرة" FontSize="11.5" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="ترقية وتحديثات نظام الرافدين ERP" FontSize="28" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="مساعد التحديث التلقائي يضمن لك الحصول على أحدث الإضافات الأمنية ومميزات المبيعات فور إطلاقها" FontSize="13.5" Foreground="#94A3B8" Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Floating Icon with Soft Glow -->
                <Border Grid.Column="1" Width="64" Height="64" CornerRadius="32" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="Update" Width="34" Height="34" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             2. MAIN WORKSPACE (DUAL-PANEL DASHBOARD LAYOUT)
        ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── LEFT PANEL: CURRENT VERSION & SYSTEM DIAGNOSTICS ─── -->
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <!-- Current Version Card -->
                <Border Style="{StaticResource KpiCard}" Padding="24" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="إصدار النظام المحلي" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                        <Border Background="#090D16" CornerRadius="14" Padding="24,20" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="24" Background="#1510B981" Margin="0,0,0,12" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="CheckCircleOutline" Width="28" Height="28" Foreground="{DynamicResource BrandSuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding CurrentVersion}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                <TextBlock Text="النسخة المشغلة محلياً" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource ModernPrimaryButton}" Height="46" Margin="0,0,0,12">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="التحقق من وجود تحديثات" FontSize="14" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <ProgressBar IsIndeterminate="{Binding IsChecking}" Visibility="{Binding IsChecking, Converter={StaticResource BooleanToVisibilityConverter}}" Height="4" Margin="0,6,0,0"/>
                        
                        <!-- Status Alert Box -->
                        <Border Background="#090D16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,12,0,0">
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrandSuccessBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12.5" FontWeight="SemiBold" LineHeight="18"/>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- System Matrix Card -->
                <Border Style="{StaticResource KpiCard}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="معايير الأمان والتوافقية" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        <Grid Margin="0,4">
                            <TextBlock Text="• معمارية النظام:" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="Windows 64-bit" FontSize="12.5" FontWeight="SemiBold" Foreground="#10B981" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="• بيئة التشغيل:" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text=".NET 8.0 Runtime" FontSize="12.5" FontWeight="SemiBold" Foreground="#38BDF8" HorizontalAlignment="Left"/>
                        </Grid>
                        <Grid Margin="0,4">
                            <TextBlock Text="• قاعدة البيانات:" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="SQLite Encrypted" FontSize="12.5" FontWeight="SemiBold" Foreground="#F59E0B" HorizontalAlignment="Left"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ─── RIGHT PANEL: UPDATE SHOWCASE / UP-TO-DATE STATUS ─── -->
            <Grid Grid.Column="1">
                <!-- A. Available Update Card (Visible when IsUpdateAvailable = true) -->
                <Border Style="{StaticResource KpiCard}" Padding="32" VerticalAlignment="Top"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel>
                        <!-- Card Header -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="تفاصيل وإضافات التحديث الجديد" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="يتوفر إصدار أحدث جاهز للتحميل والتثبيت المباشر بضغطة زر واحدة" FontSize="13.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                            </StackPanel>

                            <!-- Version Pill Badge -->
                            <Border Grid.Column="1" Background="#1510B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="16,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Creation" Width="18" Height="18" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AvailableUpdate.Version, StringFormat='الإصدار v{0}'}" FontSize="16" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Separator Style="{StaticResource ModernSeparator}" Margin="0,0,0,24"/>

                        <!-- Release Info Metadata -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="تاريخ إطلاق التحديث:" FontSize="13.5" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding AvailableUpdate.ReleaseDate, StringFormat=yyyy-MM-dd}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Grid>

                        <TextBlock Text="سجل التغييرات والمميزات الجديدة:" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12"/>
                        
                        <!-- Formatted Release Notes Container -->
                        <Border Background="#090D16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,28">
                            <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding AvailableUpdate.ReleaseNotes}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="14" LineHeight="24"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Glowing Primary Action Button -->
                        <Button Command="{Binding DownloadUpdateCommand}" IsEnabled="{Binding IsDownloading, Converter={StaticResource InvertBooleanConverter}}" 
                                Style="{StaticResource ModernSuccessButton}" Height="54" Padding="32,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Download" Width="22" Height="22" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Text="تحميل وتثبيت التحديث الآن ⚡" FontSize="16" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>

                        <!-- Real-time Download Progress Section -->
                        <Border Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                                Background="#090D16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,20,0,0">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="جاري التحميل المباشر والتثبيت التلقائي..." FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource BrandSuccessBrush}"/>
                                </Grid>
                                <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="10" IsIndeterminate="False" Foreground="{DynamicResource BrandSuccessBrush}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- B. Up-To-Date Showcase View (Visible when IsUpdateAvailable = false) -->
                <Border Style="{StaticResource KpiCard}" Padding="40" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                        Visibility="{Binding IsUpdateAvailable, Converter={StaticResource InvertBooleanToVisibilityConverter}, FallbackValue=Visible}">
                    <StackPanel HorizontalAlignment="Center" Margin="0,40">
                        <Border Width="80" Height="80" CornerRadius="40" Background="#1510B981" BorderBrush="#3010B981" BorderThickness="1" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <materialDesign:PackIcon Kind="CheckDecagram" Width="44" Height="44" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="نظامك محدّث لأحدث إصدار ✨" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                        <TextBlock Text="أنت تمتلك أحدث المميزات والإصلاحات الأمنية الخاصة بنظام الرافدين ERP." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
