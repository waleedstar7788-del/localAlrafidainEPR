<UserControl x:Class="RetailApp.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Hero Banner -->
        <Border Grid.Row="0" Margin="0,0,0,24" CornerRadius="16" Padding="28,20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0F172A" Offset="0"/>
                    <GradientStop Color="#1E293B" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Background="#2010B981" CornerRadius="8" Padding="8,4" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مركز التحديثات المباشرة" FontSize="11" FontWeight="Bold" Foreground="#10B981"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="تحديثات وترقيات نظام الرافدين ERP" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
                    <TextBlock Text="نظام التحديث التلقائي السلس يضمن لك الحصول على أحدث المميزات والأمان دائماً" FontSize="13" Foreground="#94A3B8" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Floating Glow Icon -->
                <Border Grid.Column="1" Width="56" Height="56" CornerRadius="28" Background="#1510B981" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="SystemUpdate" Width="30" Height="30" Foreground="#10B981" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 1. Left Panel: Current Version Status -->
            <Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,16,0" VerticalAlignment="Top" Padding="24">
                <StackPanel>
                    <TextBlock Text="إصدار النظام الحالي" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>

                    <Border Background="#090D16" CornerRadius="12" Padding="20" Margin="0,0,0,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel HorizontalAlignment="Center">
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="42" Height="42" Foreground="{DynamicResource BrandSuccessBrush}" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                            <TextBlock Text="{Binding CurrentVersion}" FontSize="32" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Text="النسخة المشغلة حالياً" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource ModernPrimaryButton}" Height="45" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="التحقق من وجود تحديثات" FontSize="13.5"/>
                        </StackPanel>
                    </Button>

                    <ProgressBar IsIndeterminate="{Binding IsChecking}" Visibility="{Binding IsChecking, Converter={StaticResource BooleanToVisibilityConverter}}" Height="4" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrandSuccessBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,12,0,0" FontSize="12.5" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>

            <!-- 2. Right Panel: Available New Release Card -->
            <Border Grid.Column="1" Style="{StaticResource KpiCard}" VerticalAlignment="Top" Padding="28"
                    Visibility="{Binding IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <StackPanel>
                    <!-- Title Bar -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="تفاصيل وإضافات الإصدار الجديد" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="يتوفر تحديث جاهز للتحميل والتثبيت المباشر بضغطة زر" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Version Badge -->
                        <Border Grid.Column="1" Background="#1510B981" BorderBrush="#10B981" BorderThickness="1" CornerRadius="10" Padding="14,6">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Sparkles" Width="16" Height="16" Foreground="#10B981" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding AvailableUpdate.Version, StringFormat='الإصدار v{0}'}" FontSize="15" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Separator Style="{StaticResource ModernSeparator}" Margin="0,0,0,20"/>

                    <!-- Info Grid -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="تاريخ إطلاق التحديث:" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding AvailableUpdate.ReleaseDate, StringFormat=yyyy-MM-dd}" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <TextBlock Text="الإضافات والمميزات والتحسينات الجديدة:" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,10"/>
                    
                    <!-- Release Notes Panel -->
                    <Border Background="#090D16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,24">
                        <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding AvailableUpdate.ReleaseNotes}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13.5" LineHeight="22"/>
                        </ScrollViewer>
                    </Border>

                    <!-- Main Glowing Download Button -->
                    <Button Command="{Binding DownloadUpdateCommand}" IsEnabled="{Binding IsDownloading, Converter={StaticResource InvertBooleanConverter}}" 
                            Style="{StaticResource ModernSuccessButton}" Height="50">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Download" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock Text="تحميل وتثبيت التحديث الآن ⚡" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>

                    <!-- Real-time Download Progress Bar (No Text Overlap) -->
                    <Border Visibility="{Binding IsDownloading, Converter={StaticResource BooleanToVisibilityConverter}}" 
                            Background="#090D16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="جاري التحميل المباشر والتثبيت..." FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandSuccessBrush}"/>
                            </Grid>
                            <ProgressBar Value="{Binding DownloadProgress}" Maximum="100" Height="10" IsIndeterminate="False" Foreground="{DynamicResource BrandSuccessBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
