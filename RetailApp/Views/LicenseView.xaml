<UserControl x:Class="RetailApp.Views.LicenseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="تفعيل البرنامج وإدارة التراخيص" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
            <TextBlock Text="أدخل كود التفعيل النصي المرمز (RA-...) لتفعيل التطبيق وتحديد مدة ونوع الاشتراك والجهاز." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: Current License Details Card -->
            <Border Grid.Column="0" Style="{StaticResource KpiCard}" Margin="0,0,12,0" VerticalAlignment="Top" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="Certificate" Width="28" Height="28" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="بيانات الترخيص الحالي" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="اسم العميل:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentLicense.CustomerName, FallbackValue='غير محدد'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="اسم الشركة:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentLicense.CompanyName, FallbackValue='غير محدد'}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="حالة الترخيص:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <Border Grid.Column="1" HorizontalAlignment="Left" CornerRadius="4" Padding="8,4" Background="{DynamicResource SurfaceBrush}">
                            <TextBlock Text="{Binding CurrentLicense.Status, FallbackValue='غير مفعل'}" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                        </Border>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="نوع الاشتراك:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentLicense.SubscriptionType, FallbackValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="تاريخ الانتهاء:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentLicense.ExpirationDate, StringFormat=yyyy-MM-dd, FallbackValue='-'}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="الأيام المتبقية:" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentLicense.RemainingDays, FallbackValue='0'}" FontWeight="Bold" Foreground="{DynamicResource BrandSuccessBrush}"/>
                    </Grid>

                    <Button Command="{Binding ContinueToAppCommand}"
                            Visibility="{Binding IsActivated, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Style="{StaticResource ModernPrimaryButton}"
                            Content="الانتقال إلى البرنامج ➔"
                            Height="45"
                            FontSize="15"
                            Margin="0,0,0,10"/>

                    <Button Command="{Binding DeactivateLicenseCommand}"
                            Visibility="{Binding IsActivated, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Height="44" Cursor="Hand" Margin="0,4,0,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="#1E293B" BorderBrush="#EF4444" BorderThickness="1.5" CornerRadius="8" Padding="14,0">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <materialDesign:PackIcon x:Name="icon" Kind="KeyRemove" Width="20" Height="20" Foreground="#F87171" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock x:Name="txt" Text="إلغاء التفعيل الحالي وتعديل الترخيص" FontSize="13" FontWeight="Bold" Foreground="#F87171" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#DC2626"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#B91C1C"/>
                                        <Setter TargetName="txt" Property="Foreground" Value="White"/>
                                        <Setter TargetName="icon" Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#991B1B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Right: Code-Only Activation Section -->
            <Border Grid.Column="1" Style="{StaticResource KpiCard}" Margin="12,0,0,0" VerticalAlignment="Top" Padding="20">
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <materialDesign:PackIcon Kind="KeyChain" Width="28" Height="28" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Text="تفعيل البرنامج عبر كود الترخيص" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Separator Background="{DynamicResource BorderBrush}" Margin="0,0,0,16"/>

                    <!-- Machine ID Card -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock Text="كود هذا الجهاز (Machine ID) — أرسل هذا الكود للمطور لربط الترخيص بجهازك:" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding MachineId}" IsReadOnly="True" FontStyle="Normal" FontWeight="Bold" FontFamily="Consolas" FontSize="15" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                                <Button Grid.Column="1" Command="{Binding CopyMachineIdCommand}" Style="{StaticResource ModernSecondaryButton}" Content="نسخ كود الجهاز 📋" Height="36" Padding="12,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Activation Key Card -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BrandPrimaryBrush}" BorderThickness="2" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="KeyVariant" Width="20" Height="20" Foreground="{DynamicResource BrandPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="إدخال كود التفعيل (RA-)" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="قم بلصق الكود المرمز المستلم من المطور (مثال: RA-A9X3K-8M2PQ-7W4YN...):" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10"/>
                            
                            <TextBox Text="{Binding LicenseKeyInput, UpdateSourceTrigger=PropertyChanged}" 
                                     TextWrapping="Wrap" Height="60" 
                                     Style="{StaticResource ModernTextBox}" 
                                     FontFamily="Consolas" FontSize="14" FontWeight="Bold"
                                     Margin="0,0,0,14" 
                                     materialDesign:HintAssist.Hint="RA-XXXXX-XXXXX-XXXXX-XXXXX-XXXXX"/>
                            
                            <Button Command="{Binding ActivateCommand}" Style="{StaticResource ModernPrimaryButton}" Height="46" Content="تفعيل الاشتراك الآن ⚡" FontSize="15" FontWeight="Bold"/>
                        </StackPanel>
                    </Border>

                    <!-- Status Banner -->
                    <Border Visibility="{Binding StatusMessage, Converter={StaticResource StringToVisibilityConverter}, FallbackValue=Collapsed}" CornerRadius="8" Padding="12" Margin="0,8,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#FEF2F2"/>
                                <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                        <Setter Property="Background" Value="#F0FDF4"/>
                                        <Setter Property="BorderBrush" Value="#86EFAC"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" HorizontalAlignment="Center" FontWeight="SemiBold">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#991B1B"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSuccessMessage}" Value="True">
                                            <Setter Property="Foreground" Value="#166534"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <ProgressBar IsIndeterminate="{Binding IsActivating}" Visibility="{Binding IsActivating, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,16,0,0" Height="4"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
