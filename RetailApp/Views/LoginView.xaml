<UserControl x:Class="RetailApp.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             FlowDirection="RightToLeft"
             d:DesignHeight="768" d:DesignWidth="1366">

    <UserControl.Resources>
        <!-- Floating Orb Animation 1 -->
        <Storyboard x:Key="FloatAnimation1" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="35" Duration="0:0:7" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="25" Duration="0:0:9" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="FloatAnimation2" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-45" Duration="0:0:8" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-35" Duration="0:0:10" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Floating Orb 3 (Gold accent) -->
        <Storyboard x:Key="FloatAnimation3" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="25" Duration="0:0:6" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="0" To="-20" Duration="0:0:11" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Card Entrance -->
        <Storyboard x:Key="CardEntrance">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="40" To="0" Duration="0:0:0.8">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <!-- Logo Pulse -->
        <Storyboard x:Key="LogoPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="1" To="1.06" Duration="0:0:2" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="1" To="1.06" Duration="0:0:2" AutoReverse="True">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Deep Gradient Background -->
        <Border>
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#050A15" Offset="0"/>
                    <GradientStop Color="#0B1220" Offset="0.4"/>
                    <GradientStop Color="#111827" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Floating Gradient Orb 1 (Blue) -->
        <Ellipse Width="700" Height="700" HorizontalAlignment="Right" VerticalAlignment="Top" 
                 Margin="0,-220,-200,0" IsHitTestVisible="False" Opacity="0.15">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#2563EB" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="120"/></Ellipse.Effect>
            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource FloatAnimation1}"/>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- Floating Gradient Orb 2 (Emerald) -->
        <Ellipse Width="500" Height="500" HorizontalAlignment="Left" VerticalAlignment="Bottom" 
                 Margin="-150,0,0,-150" IsHitTestVisible="False" Opacity="0.12">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#22C55E" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="140"/></Ellipse.Effect>
            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource FloatAnimation2}"/>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- Floating Gradient Orb 3 (Gold) -->
        <Ellipse Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Top" 
                 Margin="200,-80,0,0" IsHitTestVisible="False" Opacity="0.08">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#C9A227" Offset="0"/>
                    <GradientStop Color="#00000000" Offset="1"/>
                </RadialGradientBrush>
            </Ellipse.Fill>
            <Ellipse.Effect><BlurEffect Radius="100"/></Ellipse.Effect>
            <Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform>
            <Ellipse.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource FloatAnimation3}"/>
                </EventTrigger>
            </Ellipse.Triggers>
        </Ellipse>

        <!-- Subtle Grid Pattern Overlay -->
        <Border Opacity="0.025" IsHitTestVisible="False">
            <Border.Background>
                <DrawingBrush TileMode="Tile" Viewport="0,0,40,40" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing>
                            <GeometryDrawing.Geometry>
                                <GeometryGroup>
                                    <LineGeometry StartPoint="0,0" EndPoint="40,0"/>
                                    <LineGeometry StartPoint="0,0" EndPoint="0,40"/>
                                </GeometryGroup>
                            </GeometryDrawing.Geometry>
                            <GeometryDrawing.Pen>
                                <Pen Brush="White" Thickness="0.5"/>
                            </GeometryDrawing.Pen>
                        </GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Border.Background>
        </Border>

        <!-- MAIN LOGIN CARD -->
        <Border Width="500" VerticalAlignment="Center" HorizontalAlignment="Center"
                Background="#0EFFFFFF" BorderBrush="#18FFFFFF" BorderThickness="1"
                CornerRadius="28" Padding="52,48">
            <Border.Effect>
                <DropShadowEffect BlurRadius="80" Color="Black" Opacity="0.5" ShadowDepth="20" Direction="-90"/>
            </Border.Effect>
            <Border.RenderTransform>
                <TranslateTransform/>
            </Border.RenderTransform>
            <Border.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard Storyboard="{StaticResource CardEntrance}"/>
                </EventTrigger>
            </Border.Triggers>

            <Grid>
                <!-- Keyboard Enter Support -->
                <Grid.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding LoginCommand}"/>
                </Grid.InputBindings>

                <StackPanel>
                    <!-- Logo & Branding -->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,0,44">
                        <!-- Animated Logo -->
                        <Border Background="Transparent" Width="88" Height="88" CornerRadius="20" 
                                HorizontalAlignment="Center" Margin="0,0,0,20"
                                RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard Storyboard="{StaticResource LogoPulse}"/>
                                </EventTrigger>
                            </Border.Triggers>
                            <Image Source="pack://application:,,,/Assets/icon.png" Width="88" Height="88" 
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="الرافدين ERP" FontSize="30" FontWeight="Bold" 
                                   Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock Text="مرحباً بك مجدداً، يرجى تسجيل الدخول للمتابعة" FontSize="14" 
                                   Foreground="#8B9AB8" HorizontalAlignment="Center"/>
                    </StackPanel>

                    <!-- Username Field -->
                    <TextBox Text="{Binding Username}" 
                             Padding="16,16"
                             HorizontalContentAlignment="Right"
                             VerticalContentAlignment="Center"
                             materialDesign:HintAssist.Hint="اسم المستخدم" 
                             materialDesign:TextFieldAssist.LeadingIcon="AccountOutline"
                             materialDesign:TextFieldAssist.LeadingIconSize="20"
                             materialDesign:HintAssist.Foreground="#6B7B94"
                             materialDesign:HintAssist.Background="#1A2236"
                             materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                             Foreground="White" 
                             Background="#0CFFFFFF" BorderBrush="#20FFFFFF"
                             CaretBrush="#60A5FA"
                             FontSize="15"
                             Margin="0,0,0,20">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                <Style.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter Property="Background" Value="#15FFFFFF"/>
                                        <Setter Property="BorderBrush" Value="#60A5FA"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Password Field -->
                    <Grid Margin="0,0,0,20">
                        <PasswordBox x:Name="TxtPasswordBox" 
                                     Padding="40,16,16,16"
                                     HorizontalContentAlignment="Right"
                                     VerticalContentAlignment="Center"
                                     materialDesign:HintAssist.Hint="كلمة المرور" 
                                     materialDesign:TextFieldAssist.LeadingIcon="LockOutline"
                                     materialDesign:TextFieldAssist.LeadingIconSize="20"
                                     materialDesign:HintAssist.Foreground="#6B7B94"
                                     materialDesign:HintAssist.Background="#1A2236"
                                     Foreground="White" 
                                     Background="#0CFFFFFF" BorderBrush="#20FFFFFF"
                                     CaretBrush="#60A5FA"
                                     FontSize="15"
                                     materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                                     PasswordChanged="PasswordBox_PasswordChanged">
                            <PasswordBox.Style>
                                <Style TargetType="PasswordBox" BasedOn="{StaticResource MaterialDesignOutlinedPasswordBox}">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#60A5FA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </PasswordBox.Style>
                        </PasswordBox>
                        
                        <TextBox x:Name="TxtPassword" Text="{Binding Password, UpdateSourceTrigger=PropertyChanged}" 
                                 Visibility="Collapsed"
                                 Padding="40,16,16,16"
                                 HorizontalContentAlignment="Right"
                                 VerticalContentAlignment="Center"
                                 materialDesign:HintAssist.Hint="كلمة المرور" 
                                 materialDesign:TextFieldAssist.LeadingIcon="LockOutline"
                                 materialDesign:TextFieldAssist.LeadingIconSize="20"
                                 materialDesign:HintAssist.Foreground="#6B7B94"
                                 materialDesign:HintAssist.Background="#1A2236"
                                 Foreground="White" 
                                 Background="#0CFFFFFF" BorderBrush="#20FFFFFF"
                                 CaretBrush="#60A5FA"
                                 FontSize="15"
                                 materialDesign:TextFieldAssist.TextFieldCornerRadius="12"
                                 TextChanged="TxtPassword_TextChanged">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                                    <Style.Triggers>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter Property="Background" Value="#15FFFFFF"/>
                                            <Setter Property="BorderBrush" Value="#60A5FA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        
                        <!-- Eye Toggle -->
                        <Button Style="{StaticResource MaterialDesignIconForegroundButton}" 
                                HorizontalAlignment="Left" Margin="10,0" Width="34" Height="34" 
                                Foreground="#6B7B94" Padding="0" Cursor="Hand"
                                Click="TogglePasswordVisibility_Click">
                            <materialDesign:PackIcon x:Name="IconEye" Kind="EyeOutline" Width="18" Height="18"/>
                        </Button>
                    </Grid>

                    <!-- Remember Me & Forgot Password -->
                    <Grid Margin="0,0,0,36">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <CheckBox Grid.Column="0" IsChecked="{Binding RememberMe}" Content="تذكرني" 
                                  Foreground="#8B9AB8" FontSize="13"
                                  materialDesign:CheckBoxAssist.CheckBoxSize="18" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="نسيت كلمة المرور؟" 
                                Style="{StaticResource MaterialDesignFlatButton}" 
                                Foreground="#C9A227" HorizontalAlignment="Left" 
                                Padding="0" Margin="0" FontSize="13" Height="Auto" 
                                VerticalAlignment="Center" Cursor="Hand"/>
                    </Grid>

                    <!-- Login Button (Gradient with shimmer) -->
                    <Button Command="{Binding LoginCommand}" 
                            Height="56" Cursor="Hand"
                            materialDesign:ButtonAssist.CornerRadius="14"
                            materialDesign:ElevationAssist.Elevation="Dp2"
                            BorderThickness="0" FontSize="16" FontWeight="SemiBold" Foreground="White"
                            RenderTransformOrigin="0.5,0.5">
                        <Button.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Button.RenderTransform>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#2563EB" Offset="0"/>
                                            <GradientStop Color="#3B82F6" Offset="0.5"/>
                                            <GradientStop Color="#60A5FA" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                        <Button.Triggers>
                            <EventTrigger RoutedEvent="MouseEnter">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.15">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                            <EventTrigger RoutedEvent="MouseLeave">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Button.Triggers>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="تسجيل الدخول" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <materialDesign:PackIcon Kind="ArrowLeft" VerticalAlignment="Center" Width="20" Height="20"/>
                        </StackPanel>
                    </Button>

                    <!-- Version Footer -->
                    <TextBlock Text="الإصدار 2.0.0 — جميع الحقوق محفوظة © 2026" FontSize="11" 
                               Foreground="#4B5B73" HorizontalAlignment="Center" Margin="0,32,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
