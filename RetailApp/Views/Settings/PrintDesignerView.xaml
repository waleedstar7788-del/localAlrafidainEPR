<UserControl x:Class="RetailApp.Views.Settings.PrintDesignerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="clr-namespace:RetailApp.Controls.PrintTemplates"
             FlowDirection="RightToLeft"
             Background="{DynamicResource SurfaceBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="350"/> <!-- Toolbox -->
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/> <!-- Live Canvas -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Toolbox -->
        <Border Grid.Column="0" Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Actions -->
                <StackPanel Grid.Row="0" Margin="16">
                    <TextBlock Text="مصمم قوالب الطباعة" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16"/>
                    
                    <!-- Template Selector -->
                    <TextBlock Text="القالب الحالي:" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,4"/>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0" ItemsSource="{Binding Templates}" SelectedItem="{Binding ActiveTemplate}" DisplayMemberPath="Name" Style="{DynamicResource ModernComboBox}"/>
                        <Button Grid.Column="1" Command="{Binding CreateNewTemplateCommand}" Style="{StaticResource ModernPrimaryButton}" materialDesign:ButtonAssist.CornerRadius="4" Width="40" Padding="0" Margin="8,0,0,0">
                            <materialDesign:PackIcon Kind="Plus"/>
                        </Button>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <Button Content="تكرار" Command="{Binding DuplicateTemplateCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0" Width="90"/>
                        <Button Content="حذف" Command="{Binding DeleteTemplateCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Foreground="{DynamicResource BrandDangerBrush}" BorderBrush="{DynamicResource BrandDangerBrush}" Width="90"/>
                    </StackPanel>
                </StackPanel>

                <Rectangle Grid.Row="0" VerticalAlignment="Bottom" Height="1" Fill="{DynamicResource BorderBrush}"/>

                <!-- Properties Accordion -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="IsEnabled" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveTemplate}" Value="{x:Null}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        
                        <!-- General Info -->
                        <TextBlock Text="إعدادات عامة" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="اسم القالب" Text="{Binding ActiveTemplate.Name, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        
                        <ComboBox materialDesign:HintAssist.Hint="مقاس الورق" SelectedItem="{Binding ActiveTemplate.PaperSize, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernComboBox}" Margin="0,0,0,12">
                            <sys:String>A4</sys:String>
                            <sys:String>80mm</sys:String>
                            <sys:String>58mm</sys:String>
                        </ComboBox>

                        <TextBox materialDesign:HintAssist.Hint="عرض الريزيت (بكسل)" Text="{Binding ActiveTemplate.ReceiptWidth, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,24"/>

                        <!-- Company Overrides -->
                        <TextBlock Text="معلومات الشركة (تجاوز الافتراضي)" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="اسم الشركة" Text="{Binding ActiveTemplate.CompanyName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="الاسم العربي" Text="{Binding ActiveTemplate.CompanyArabicName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="العنوان" Text="{Binding ActiveTemplate.CompanyAddress, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="الرقم الضريبي (VAT)" Text="{Binding ActiveTemplate.CompanyTaxNumber, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="السجل التجاري (CR)" Text="{Binding ActiveTemplate.CompanyCR, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="رقم الهاتف" Text="{Binding ActiveTemplate.CompanyPhone, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="البريد الإلكتروني" Text="{Binding ActiveTemplate.CompanyEmail, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,24"/>

                        <!-- Layout Elements -->
                        <TextBlock Text="العناصر المرئية والأعمدة" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                        <Button Content="اختيار شعار (Logo)" Command="{Binding SelectLogoCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,0,8" HorizontalAlignment="Stretch"/>
                        <TextBox materialDesign:HintAssist.Hint="مسار الشعار (تلقائي)" Text="{Binding ActiveTemplate.LogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" IsReadOnly="True" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="الهوامش (يسار,أعلى,يمين,أسفل)" Text="{Binding ActiveTemplate.Margins, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>

                        <CheckBox Content="إظهار الشعار (Logo)" IsChecked="{Binding ActiveTemplate.ShowLogo}" Margin="0,0,0,8"/>
                        <CheckBox Content="إظهار رمز QR" IsChecked="{Binding ActiveTemplate.ShowQR}" Margin="0,0,0,8"/>
                        <CheckBox Content="إظهار الباركود" IsChecked="{Binding ActiveTemplate.ShowBarcode}" Margin="0,0,0,8"/>
                        <CheckBox Content="إظهار عمود الضريبة" IsChecked="{Binding ActiveTemplate.ShowTaxColumn}" Margin="0,0,0,8"/>
                        <CheckBox Content="إظهار عمود الخصم" IsChecked="{Binding ActiveTemplate.ShowDiscountColumn}" Margin="0,0,0,8"/>
                        <CheckBox Content="تلوين الصفوف بالتناوب" IsChecked="{Binding ActiveTemplate.AlternatingRowColors}" Margin="0,0,0,24"/>

                        <!-- Formatting -->
                        <TextBlock Text="التنسيق العام" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="بادئة الفاتورة (Prefix)" Text="{Binding ActiveTemplate.InvoicePrefix, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="تنسيق التاريخ" Text="{Binding ActiveTemplate.DateFormat, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="رمز العملة" Text="{Binding ActiveTemplate.CurrencyDisplay, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,24"/>

                        <!-- Text & Titles -->
                        <TextBlock Text="النصوص والعناوين" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                        <TextBox materialDesign:HintAssist.Hint="عنوان الفاتورة" Text="{Binding ActiveTemplate.InvoiceTitle, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="النص الترحيبي (Header)" Text="{Binding ActiveTemplate.HeaderText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" AcceptsReturn="True" Height="60" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="نص الشكر (Footer)" Text="{Binding ActiveTemplate.FooterText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" AcceptsReturn="True" Height="60" Margin="0,0,0,24"/>

                        <!-- Styling & Typography -->
                        <TextBlock Text="الأبعاد والخطوط" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,8"/>
                        <ComboBox materialDesign:HintAssist.Hint="نوع الخط" SelectedItem="{Binding ActiveTemplate.FontFamily, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernComboBox}" Margin="0,0,0,12">
                            <sys:String>Cairo</sys:String>
                            <sys:String>Tajawal</sys:String>
                            <sys:String>Arial</sys:String>
                        </ComboBox>
                        
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="غامق" IsChecked="{Binding ActiveTemplate.IsBold}" Margin="0,0,12,0"/>
                            <CheckBox Content="مائل" IsChecked="{Binding ActiveTemplate.IsItalic}" Margin="0,0,12,0"/>
                            <CheckBox Content="تسطير" IsChecked="{Binding ActiveTemplate.IsUnderlined}"/>
                        </StackPanel>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" materialDesign:HintAssist.Hint="حجم الخط" Text="{Binding ActiveTemplate.FontSize, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}"/>
                            <TextBox Grid.Column="2" materialDesign:HintAssist.Hint="حجم الشعار" Text="{Binding ActiveTemplate.LogoSize, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}"/>
                        </Grid>

                        <ComboBox materialDesign:HintAssist.Hint="محاذاة النص" SelectedItem="{Binding ActiveTemplate.TextAlignment, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernComboBox}" Margin="0,0,0,12">
                            <sys:String>Right</sys:String>
                            <sys:String>Center</sys:String>
                            <sys:String>Left</sys:String>
                        </ComboBox>

                        <TextBox materialDesign:HintAssist.Hint="اللون الأساسي (HEX)" Text="{Binding ActiveTemplate.PrimaryColor, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,12"/>
                        <TextBox materialDesign:HintAssist.Hint="لون الحدود (HEX)" Text="{Binding ActiveTemplate.BorderColor, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,24"/>

                    </StackPanel>
                </ScrollViewer>

                <!-- Footer Actions -->
                <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Command="{Binding TestPrintCommand}" Style="{StaticResource MaterialDesignOutlinedButton}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Printer" Margin="0,0,8,0"/>
                                <TextBlock Text="طباعة تجريبية"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveTemplateCommand}" Style="{StaticResource ModernPrimaryButton}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSave" Margin="0,0,8,0"/>
                                <TextBlock Text="حفظ القالب"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="1" Background="{DynamicResource BorderBrush}"/>

        <!-- Live Preview Canvas Area -->
        <Grid Grid.Column="2" Background="{DynamicResource BackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Zoom Toolbar -->
            <Border Grid.Row="0" Background="{DynamicResource SurfaceHighlightBrush}" Padding="16,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Command="{Binding ZoomOutCommand}" Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="MagnifyMinusOutline"/>
                    </Button>
                    <TextBlock Text="{Binding ZoomPercentage}" VerticalAlignment="Center" Margin="16,0" FontWeight="Bold"/>
                    <Button Command="{Binding ZoomInCommand}" Style="{StaticResource MaterialDesignToolButton}">
                        <materialDesign:PackIcon Kind="MagnifyPlusOutline"/>
                    </Button>
                    <Button Command="{Binding ZoomResetCommand}" Style="{StaticResource MaterialDesignToolButton}" Margin="16,0,0,0">
                        <materialDesign:PackIcon Kind="MagnifyScan"/>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Preview Canvas -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#E2E8F0">
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="40">
                    <Viewbox.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ZoomLevel}" ScaleY="{Binding ZoomLevel}"/>
                    </Viewbox.LayoutTransform>

                    <!-- Shadow wrapper for the paper -->
                    <Border Background="White" Effect="{DynamicResource MaterialDesignElevationShadow3}" Margin="20">
                        
                        <!-- Content Presenter that chooses Thermal vs A4 -->
                        <ContentControl Content="{Binding PreviewContext}">
                            <ContentControl.Style>
                                <Style TargetType="ContentControl">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PreviewContext.Template.PaperSize}" Value="A4">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <!-- Fixed A4 Aspect Ratio roughly (Width=794 for 96 DPI, Height=1123) -->
                                                        <controls:A4PreviewTemplate Width="794" MinHeight="1123" Margin="10" DataContext="{Binding}"/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewContext.Template.PaperSize}" Value="80mm">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <controls:ReceiptPreviewTemplate Width="{Binding Template.ReceiptWidth}" Margin="10" DataContext="{Binding}"/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PreviewContext.Template.PaperSize}" Value="58mm">
                                            <Setter Property="ContentTemplate">
                                                <Setter.Value>
                                                    <DataTemplate>
                                                        <controls:ReceiptPreviewTemplate Width="{Binding Template.ReceiptWidth}" Margin="10" DataContext="{Binding}"/>
                                                    </DataTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                        </ContentControl>
                    </Border>
                </Viewbox>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
