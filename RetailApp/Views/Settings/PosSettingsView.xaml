<UserControl x:Class="RetailApp.Views.Settings.PosSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
        <TextBlock Text="إعدادات الكاشير ونقطة البيع" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,32"/>
        
        <!-- Barcode Scanner Option -->
        <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="منفذ ماسح الباركود" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="حدد المنفذ الخاص بجهاز مسح الباركود (مثال: USB أو COM3)" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding LocalSettings.BarcodeScannerPort, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Width="200" VerticalAlignment="Center" FontSize="15" materialDesign:HintAssist.Hint="USB / COM3"/>
            </Grid>
        </Border>

        <!-- Cash Drawer Option -->
        <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="منفذ درج الكاشير" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="حدد المنفذ الخاص بدرج النقود ليتم فتحه تلقائياً عند الدفع" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBox Grid.Column="1" Text="{Binding LocalSettings.CashDrawerPort, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Width="200" VerticalAlignment="Center" FontSize="15" materialDesign:HintAssist.Hint="COM1"/>
            </Grid>
        </Border>

        <!-- Auto Save Invoice Option -->
        <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="حفظ الفاتورة تلقائياً" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="تفعيل حفظ الفاتورة وإغلاقها مباشرة عند الضغط على إتمام الدفع" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{Binding DbSettings.AutoSaveInvoice, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Width="50" Height="28" VerticalAlignment="Center"/>
            </Grid>
        </Border>

    </StackPanel>
</UserControl>
