<UserControl x:Class="RetailApp.Views.Settings.BackupSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,24,0">
            <TextBlock Text="إعدادات النسخ الاحتياطي" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
            
            <TextBox materialDesign:HintAssist.Hint="مسار النسخ الاحتياطي" Text="{Binding ScheduleConfig.BackupFolder, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,16"/>
            
            <ComboBox materialDesign:HintAssist.Hint="معدل النسخ التلقائي" SelectedItem="{Binding ScheduleConfig.Frequency, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernComboBox}" Margin="0,0,0,16">
                <!-- Assuming Enum mapping or standard items. We'll just bind directly. -->
            </ComboBox>

            <TextBox materialDesign:HintAssist.Hint="الاحتفاظ بالنسخ الاحتياطية (أيام)" Text="{Binding ScheduleConfig.RetentionDays, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Margin="0,0,0,24"/>
            
            <Button Content="حفظ إعدادات الجدولة" Command="{Binding SaveSettingsCommand}" Style="{DynamicResource ModernPrimaryButton}" Margin="0,0,0,32" HorizontalAlignment="Left"/>
        </StackPanel>

        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" Margin="16" Padding="24">
            <StackPanel>
                <TextBlock Text="العمليات اليدوية" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource BrandPrimaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding ProgressText}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,16" TextWrapping="Wrap"/>
                
                <Button Content="إنشاء نسخة احتياطية الآن" Command="{Binding CreateBackupCommand}" Style="{DynamicResource ModernPrimaryButton}" Margin="0,0,0,16" Height="40"/>
                
                <TextBlock Text="تاريخ النسخ السابقة:" Margin="0,16,0,8"/>
                <ListBox ItemsSource="{Binding BackupHistory}" MinHeight="150" Background="Transparent" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,0,16">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Date, StringFormat={}{0:g}}" Margin="0,0,16,0"/>
                                <TextBlock Text="{Binding SizeText}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Button Content="استعادة النسخة المحددة" Command="{Binding RestoreBackupCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ListBox}, Path=SelectedItem}" Style="{DynamicResource ModernSecondaryButton}" Height="40"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
