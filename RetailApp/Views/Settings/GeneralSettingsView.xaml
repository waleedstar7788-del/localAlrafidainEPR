<UserControl x:Class="RetailApp.Views.Settings.GeneralSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <StackPanel MaxWidth="800" HorizontalAlignment="Left">
        <TextBlock Text="الإعدادات العامة" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,32"/>
        
        <!-- Language Option -->
        <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="لغة النظام" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="اختر لغة الواجهة الأساسية للبرنامج على هذا الجهاز." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <ComboBox Grid.Column="1" SelectedItem="{Binding LocalSettings.DefaultLanguage, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernComboBox}" Width="150" VerticalAlignment="Center" FontSize="15">
                    <sys:String>ar</sys:String>
                    <sys:String>en</sys:String>
                </ComboBox>
            </Grid>
        </Border>

        <!-- Auto Save Option -->
        <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="حفظ تلقائي" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="تفعيل الحفظ التلقائي للبيانات في الخلفية لمنع فقدانها." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{Binding LocalSettings.AutoSave, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Width="50" Height="28" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Auto Refresh Option -->
        <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24,20" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                    <TextBlock Text="تحديث تلقائي للشاشات" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="تحديث الجداول والبيانات بشكل مستمر دون الحاجة للتحديث اليدوي." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
                <ToggleButton Grid.Column="1" IsChecked="{Binding LocalSettings.AutoRefresh, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource MaterialDesignSwitchToggleButton}" Width="50" Height="28" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
