<UserControl x:Class="RetailApp.Views.Settings.PrintingSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <Grid MaxWidth="1200">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="400"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,32,0">
            <TextBlock Text="إعدادات الطباعة والفواتير" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,32"/>
            
            <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24" Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="الأجهزة والطابعات" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="طابعة الفواتير (الريزيت)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="اسم الطابعة المخصصة لطباعة إيصالات نقاط البيع." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding LocalSettings.ReceiptPrinterName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Width="200" VerticalAlignment="Center" FontSize="15" materialDesign:HintAssist.Hint="Microsoft Print to PDF"/>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="طابعة التقارير (A4)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="اسم الطابعة المخصصة لطباعة التقارير والفواتير الكبيرة." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding LocalSettings.A4PrinterName, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Width="200" VerticalAlignment="Center" FontSize="15" materialDesign:HintAssist.Hint="Microsoft Print to PDF"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource SurfaceHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="24">
                <StackPanel>
                    <TextBlock Text="تنسيق الفاتورة" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24"/>
                    
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="قالب الفاتورة" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="اختر التصميم والشكل المناسب لشكل الفاتورة المطبوعة." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" SelectedItem="{Binding LocalSettings.InvoiceTemplate, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernComboBox}" Width="200" VerticalAlignment="Center" FontSize="15">
                            <sys:String>Standard</sys:String>
                            <sys:String>Professional</sys:String>
                            <sys:String>Minimalist</sys:String>
                        </ComboBox>
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,24,0">
                            <TextBlock Text="عرض إيصال الريزيت (مم)" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="عرض الورق الخاص بطابعة الإيصالات (مثال: 80 أو 58)." FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <TextBox Grid.Column="1" Text="{Binding DbSettings.ReceiptWidth, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" Width="100" VerticalAlignment="Center" FontSize="15" TextAlignment="Center"/>
                    </Grid>
                    
                    <TextBox materialDesign:HintAssist.Hint="مسار شعار المؤسسة (Logo Path)" Text="{Binding LocalSettings.LogoPath, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" FontSize="15" Margin="0,0,0,24"/>
                    
                    <TextBox materialDesign:HintAssist.Hint="النص الترحيبي في أعلى الفاتورة (Header)" Text="{Binding LocalSettings.HeaderText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" FontSize="15" Margin="0,0,0,24" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                    
                    <TextBox materialDesign:HintAssist.Hint="نص الشكر في أسفل الفاتورة (Footer)" Text="{Binding LocalSettings.FooterText, UpdateSourceTrigger=PropertyChanged}" Style="{DynamicResource ModernTextBox}" FontSize="15" Margin="0,0,0,8" TextWrapping="Wrap" AcceptsReturn="True" Height="60"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Live Print Preview -->
        <Border Grid.Column="1" Background="{DynamicResource SurfaceBrush}" CornerRadius="12" Padding="24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,64,0,0">
            <StackPanel>
                <TextBlock Text="معاينة حية للإيصال" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,24" HorizontalAlignment="Center"/>
                <Border Background="White" Width="300" MinHeight="400" CornerRadius="4" Padding="24" HorizontalAlignment="Center" Effect="{DynamicResource MaterialDesignElevationShadow3}">
                    <StackPanel TextElement.Foreground="Black">
                        <!-- Header -->
                        <TextBlock Text="{Binding DbSettings.ArabicName}" HorizontalAlignment="Center" FontWeight="Bold" FontSize="18" Margin="0,0,0,8"/>
                        <TextBlock Text="{Binding LocalSettings.HeaderText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,24" Foreground="#444"/>
                        
                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#AAA" StrokeDashArray="2,2" Margin="0,0,0,16"/>

                        <!-- Items -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="وجبة برجر كومبو" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Grid.Column="1" Text="15,000" FontSize="13" FontWeight="Medium"/>
                        </Grid>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="مشروب غازي إضافي" FontSize="13" FontWeight="Medium"/>
                            <TextBlock Grid.Column="1" Text="2,000" FontSize="13" FontWeight="Medium"/>
                        </Grid>

                        <!-- Separator -->
                        <Rectangle Height="1" Fill="#AAA" StrokeDashArray="2,2" Margin="0,0,0,16"/>

                        <!-- Total -->
                        <Grid Margin="0,0,0,24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="الإجمالي المستحق:" FontWeight="Bold" FontSize="15"/>
                            <TextBlock Grid.Column="1" Text="17,000 د.ع" FontWeight="Bold" FontSize="15"/>
                        </Grid>

                        <!-- Footer -->
                        <TextBlock Text="{Binding LocalSettings.FooterText}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="12" Foreground="#444"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
