<UserControl x:Class="RetailApp.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             FlowDirection="RightToLeft">
    
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Page Header Banner -->
        <Border Grid.Row="0" CornerRadius="12" Padding="20,16" Margin="0,0,0,16">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#0F172A" Offset="0.0"/>
                    <GradientStop Color="#1E293B" Offset="1.0"/>
                </LinearGradientBrush>
            </Border.Background>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="InformationOutline" Width="26" Height="26" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="حول نظام الرافدين ERP" FontSize="20" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="دليل النظام، إمكانيات المنظومة، المعايير التقنية وحقوق الملكية" FontSize="12" Foreground="#94A3B8" Margin="36,4,0,0"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1E293B" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckDecagram" Width="18" Height="18" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBlock Text="إصدار محترف v1.0.0 Pro" Foreground="#E2E8F0" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Hero App Card -->
                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- App Logo -->
                        <Border Grid.Column="0" Width="80" Height="80" CornerRadius="16" Background="#1E293B" Margin="0,0,20,0" VerticalAlignment="Center">
                            <Image Source="pack://application:,,,/Assets/icon.png" Width="60" Height="60" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="الرافدين ERP" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                <Border Background="#065F46" BorderBrush="#10B981" BorderThickness="1" CornerRadius="12" Padding="10,3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="النظام المستقر ⚡" FontSize="11" FontWeight="Bold" Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="منظومة متكاملة وشاملة لتخطيط وإدارة كافة العمليات التجارية للمتاجر والمؤسسات بدقة فائقة." 
                                       FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,10"/>

                            <StackPanel Orientation="Horizontal">
                                <Border Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Laptop" Width="14" Height="14" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text=".NET 8.0 WPF Engine" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="6" Padding="10,4" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Database" Width="14" Height="14" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="SQLite High Performance" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="6" Padding="10,4">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ShieldLock" Width="14" Height="14" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock Text="HMAC-SHA256 Encrypted" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Modules & Capabilities Grid -->
                <TextBlock Text="إمكانيات ووظائف المنظومة المتكاملة" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,4,0,12"/>

                <UniformGrid Columns="3" Margin="0,0,0,16">
                    <!-- POS -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="PointOfSale" Width="20" Height="20" Foreground="#2563EB" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="المبيعات ونقاط البيع (POS)" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="إصدار سريع للفواتير، دعم الباركوود، خيارات الخصم، وطباعة الإيصالات الحرارية وفواتير A4." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Inventory -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="PackageVariantClosed" Width="20" Height="20" Foreground="#059669" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="المخزون والمستودعات" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="إدارة جرد المواد، تنبيهات تلقائية للنواقص وصلاحيات المنتجات، وتنقّلات المستودعات." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Accounting -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="Calculator" Width="20" Height="20" Foreground="#7C3AED" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="المحاسبة والمالية" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="شجرة حسابات شجرية كاملة، سندات القبض والصرف، القيود اليومية، والتقارير المالية." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Customers & Installments -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="AccountGroup" Width="20" Height="20" Foreground="#D97706" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="العملاء والأقساط والديون" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="كشوفات حساب تفصيلية للعملاء، متابعة الأقساط والديون، وتنبيهات مواعيد التسديد." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- HR & Payroll -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,10,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="BadgeAccountHorizontal" Width="20" Height="20" Foreground="#DC2626" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="الموظفون والرواتب" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="سجلات الموظفين، إدارة السُلف والحسومات، وتوليد مسير الرواتب الشهري المعتمد." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>

                    <!-- Security & Backups -->
                    <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,0,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <materialDesign:PackIcon Kind="ShieldCheck" Width="20" Height="20" Foreground="#0284C7" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="الأمان والنسخ الاحتياطي" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="صلاحيات متعددة للمستخدمين، نسخ احتياطي تلقائي ومحلي لحماية البيانات من الضياع." FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="16"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!-- Technical Specs & Rights Section -->
                <Grid Margin="0,4,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Tech Specs -->
                    <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="CogOutline" Width="20" Height="20" Foreground="#38BDF8" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="المواصفات والبيئة التشغيلية" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="إصدار التطبيق:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,6"/>
                                <TextBlock Grid.Row="0" Grid.Column="1" Text="1.0.0 Pro (Build 2026)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="نظام التراخيص:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,6"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="كود رمزي مشفر (Code-Only Activation)" FontSize="12" FontWeight="Bold" Foreground="#10B981" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="تحديثات النظام:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,6"/>
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="متصل تلقائياً بـ GitHub Releases Stream" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6"/>

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="التوافقية:" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,12,0"/>
                                <TextBlock Grid.Row="3" Grid.Column="1" Text="Windows 10 / 11 (x64 Architecture)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,0"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Right: Developer & Support -->
                    <Border Grid.Column="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <materialDesign:PackIcon Kind="Headset" Width="20" Height="20" Foreground="#F59E0B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="حقوق النشر والدعم الفني" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <TextBlock Text="تم تطوير وتصميم هذه المنظومة بواسطة فريق الرافدين للحلول البرمجية الذكية لتقديم أفضل تجربة محاسبية وإدارية." 
                                       FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,12"/>

                            <Border Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="ShieldCheckOutline" Width="18" Height="18" Foreground="#10B981" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="جميع الحقوق محفوظة © 2026 — الرافدين ERP" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
