<UserControl x:Class="RetailApp.Views.DeveloperDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             FlowDirection="RightToLeft">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="لوحة تحكم المطورين (لإصدار التراخيص)" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource DangerBrush}"/>
            <TextBlock Text="هذه الشاشة مخصصة للإدارة فقط لإنشاء التراخيص وربطها بالأجهزة" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource KpiCard}" VerticalAlignment="Top">
            <StackPanel>
                <TextBox materialDesign:HintAssist.Hint="اسم العميل" Text="{Binding CustomerName}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>
                <TextBox materialDesign:HintAssist.Hint="رقم الجهاز (Machine ID)" Text="{Binding TargetMachineId}" Style="{StaticResource ModernTextBox}" Margin="0,0,0,16"/>
                
                <ComboBox materialDesign:HintAssist.Hint="نوع الاشتراك" SelectedItem="{Binding SelectedLicenseType}" Style="{StaticResource ModernComboBox}" Margin="0,0,0,16">
                    <sys:String>Trial</sys:String>
                    <sys:String>Monthly</sys:String>
                    <sys:String>Quarterly</sys:String>
                    <sys:String>Yearly</sys:String>
                    <sys:String>Lifetime</sys:String>
                </ComboBox>

                <Button Command="{Binding GenerateLicenseCommand}" Style="{StaticResource ModernPrimaryButton}" Content="توليد مفتاح تفعيل" Height="45" Margin="0,0,0,24"/>

                <TextBlock Text="ملف التفعيل الناتج (قم بنسخه للعميل):" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                <TextBox Text="{Binding GeneratedLicenseJson}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" Height="200" FontFamily="Consolas" Style="{StaticResource ModernTextBox}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
