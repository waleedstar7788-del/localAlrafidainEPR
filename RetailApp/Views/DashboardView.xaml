<UserControl x:Class="RetailApp.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:RetailApp.Controls"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <!-- Staggered Entrance Animations -->
        <Storyboard x:Key="WelcomeEntrance">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.5" BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.5" BeginTime="0:0:0.1">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="KpiEntrance">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.25">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="25" To="0" Duration="0:0:0.6" BeginTime="0:0:0.25">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="ChartsEntrance">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="25" To="0" Duration="0:0:0.6" BeginTime="0:0:0.45">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
        <Storyboard x:Key="BottomEntrance">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.6" BeginTime="0:0:0.65">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="25" To="0" Duration="0:0:0.6" BeginTime="0:0:0.65">
                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>
    </UserControl.Resources>

    <Grid>
        <!-- Loading Overlay -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="10">
            <Grid.Background>
                <DynamicResource ResourceKey="OverlayBackgroundBrush"/>
            </Grid.Background>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" Value="0" IsIndeterminate="True" 
                             Width="44" Height="44" HorizontalAlignment="Center" Foreground="{DynamicResource BrandPrimaryBrush}"/>
                <TextBlock Text="جاري تحميل البيانات..." Margin="0,16,0,0" FontWeight="SemiBold" FontSize="15"
                           Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Main Dashboard -->
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- ═══ WELCOME HEADER ═══ -->
                <Grid Margin="0,0,0,28" Opacity="0">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource WelcomeEntrance}"/>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="مرحباً، أحمد"/><Run Text=" 👋" FontSize="24"/>
                        </TextBlock>
                        <TextBlock Text="{Binding CurrentDate}" FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                    </StackPanel>
                    <!-- Quick Actions -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding CreateInvoiceCommand}" Padding="18,10" Height="40">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="18" Height="18" Margin="0,0,8,0"/>
                                <TextBlock Text="فاتورة جديدة" FontSize="13"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ═══ KPI STATS ROW ═══ -->
                <ItemsControl ItemsSource="{Binding Stats}" Margin="0,0,0,24" Opacity="0">
                    <ItemsControl.RenderTransform><TranslateTransform/></ItemsControl.RenderTransform>
                    <ItemsControl.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource KpiEntrance}"/>
                        </EventTrigger>
                    </ItemsControl.Triggers>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:StatCardControl Margin="0,0,16,16" Width="280"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- ═══ CHARTS SECTION ═══ -->
                <Grid Margin="0,0,0,24" Opacity="0">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource ChartsEntrance}"/>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Line Chart -->
                    <Border Grid.Column="0" Style="{StaticResource KpiCard}" Padding="24,20" MinHeight="340">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="المبيعات اليومية" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="آخر 7 أيام" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <lvc:CartesianChart Grid.Row="1" Series="{Binding DailySalesSeries}" FlowDirection="LeftToRight"/>
                        </Grid>
                    </Border>

                    <!-- Pie Chart -->
                    <Border Grid.Column="2" Style="{StaticResource KpiCard}" Padding="24,20" MinHeight="340">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="توزيع المبيعات" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="حسب الفئة" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <lvc:PieChart Grid.Row="1" Series="{Binding SalesByCategorySeries}" LegendPosition="Bottom" FlowDirection="LeftToRight"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══ BOTTOM SECTION ═══ -->
                <Grid Margin="0,0,0,16" Opacity="0">
                    <Grid.RenderTransform><TranslateTransform/></Grid.RenderTransform>
                    <Grid.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard Storyboard="{StaticResource BottomEntrance}"/>
                        </EventTrigger>
                    </Grid.Triggers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Recent Activities -->
                    <Border Grid.Column="0" Style="{StaticResource KpiCard}" Padding="24,20" MinHeight="280">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="آخر النشاطات" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button HorizontalAlignment="Left" Style="{StaticResource ModernGhostButton}" Padding="8,4" Height="Auto"
                                        Foreground="{DynamicResource BrandAccentBrush}" FontSize="12" Content="عرض الكل"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding RecentActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:ActivityItemControl Margin="0,0,0,4"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Notifications / Alerts -->
                    <Border Grid.Column="2" Style="{StaticResource KpiCard}" Padding="24,20" MinHeight="280">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <TextBlock Text="التنبيهات" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,-4,0,0">
                                    <materialDesign:PackIcon Kind="BellOutline" Foreground="{DynamicResource TextSecondaryBrush}" Width="20" Height="20" VerticalAlignment="Center"/>
                                    <Border Background="{DynamicResource BrandDangerBrush}" CornerRadius="10" Padding="5,1" Margin="4,-8,0,0" VerticalAlignment="Top" Height="18" MinWidth="18">
                                        <TextBlock Text="{Binding Notifications.Count}" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- Alert 1 -->
                            <Border Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource BrandDangerTransparentBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="AlertOutline" Foreground="{DynamicResource BrandDangerBrush}" 
                                                                 Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="منتج منخفض المخزون: لابتوب HP" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="منذ 5 دقائق" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Alert 2 -->
                            <Border Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="10" Background="{DynamicResource BrandWarningTransparentBrush}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <materialDesign:PackIcon Kind="BellRingOutline" Foreground="{DynamicResource BrandWarningBrush}" 
                                                                 Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="فاتورة مستحقة #INV-1002" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold"/>
                                        <TextBlock Text="منذ 15 دقيقة" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Button Style="{StaticResource ModernGhostButton}" Foreground="{DynamicResource BrandAccentBrush}" 
                                    Margin="0,8,0,0" Content="عرض جميع التنبيهات" FontSize="13" Padding="0,6" Height="Auto"/>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
