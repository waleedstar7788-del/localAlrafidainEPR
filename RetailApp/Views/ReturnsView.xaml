<UserControl x:Class="RetailApp.Views.ReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Stats -->
            <RowDefinition Height="Auto"/>  <!-- Actions -->
            <RowDefinition Height="*"/>     <!-- Tabs & DataGrids -->
        </Grid.RowDefinitions>

        <!-- ═══ PAGE HEADER ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="إدارة المرتجعات" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="إدارة مرتجعات المبيعات من العملاء ومرتجعات المشتريات للموردين" FontSize="13" 
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═══ KPI STATS ROW ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="مرتجعات المبيعات (الشهر)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding MonthlySalesReturnTotal, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandWarningBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="مرتجعات المشتريات (الشهر)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding MonthlyPurchaseReturnTotal, StringFormat={}{0:N2}}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource BrandSuccessBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource KpiCard}">
                <StackPanel>
                    <TextBlock Text="إجمالي عدد العمليات اليوم" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" Margin="0,0,0,8"/>
                    <TextBlock Text="{Binding TodayReturnsCount}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ═══ ACTIONS ═══ -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource ModernPrimaryButton}" Padding="18,10" Height="40" Command="{Binding OpenSalesReturnEditorCommand}" Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowLeftBottom" Margin="0,0,8,0" Width="18" Height="18"/>
                        <TextBlock Text="مرتجع مبيعات (من عميل)" FontSize="13"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource ModernSuccessButton}" Padding="18,10" Height="40" Command="{Binding OpenPurchaseReturnEditorCommand}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ArrowRightTop" Margin="0,0,8,0" Width="18" Height="18"/>
                        <TextBlock Text="مرتجع مشتريات (لمورد)" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ TABS & DATAGRIDS ═══ -->
        <TabControl Grid.Row="3" Background="Transparent" BorderThickness="0" Margin="0,4,0,0">
            <TabControl.Resources>
                <Style TargetType="TabItem">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border Name="Border" Padding="24,14" Margin="0,0,8,0" CornerRadius="12,12,0,0" Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,1,1,0">
                                    <ContentPresenter x:Name="ContentSite" VerticalAlignment="Center" HorizontalAlignment="Center" ContentSource="Header" RecognizesAccessKey="True"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Border" Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
                                        <Setter TargetName="Border" Property="BorderThickness" Value="0"/>
                                        <Setter Property="Foreground" Value="White"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="False">
                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                        <Setter Property="FontWeight" Value="Medium"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>

            <TabItem Header="مرتجعات المبيعات">
                <Border Style="{StaticResource KpiCard}" Padding="0" CornerRadius="0,14,14,14" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding SalesReturns}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNumber}" Width="120"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding ReturnDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="العميل" Binding="{Binding Customer.FullName, TargetNullValue='عميل نقدي'}" Width="2*"/>
                            <DataGridTextColumn Header="طريقة الاسترداد" Binding="{Binding RefundMethod}" Width="150"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalRefundAmount, StringFormat={}{0:N2}}" Width="1.5*"/>
                            
                            <DataGridTemplateColumn Header="الحالة" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgeSuccess}">
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrandSuccessBrush}" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="إجراءات" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="إلغاء المرتجع"
                                                Foreground="{DynamicResource BrandDangerBrush}"
                                                Command="{Binding DataContext.CancelSalesReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Cancel" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="مرتجعات المشتريات">
                <Border Style="{StaticResource KpiCard}" Padding="0" CornerRadius="0,14,14,14" ClipToBounds="True">
                    <DataGrid ItemsSource="{Binding PurchaseReturns}" AutoGenerateColumns="False" IsReadOnly="True"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="رقم المرتجع" Binding="{Binding ReturnNumber}" Width="120"/>
                            <DataGridTextColumn Header="التاريخ" Binding="{Binding ReturnDate, StringFormat={}{0:dd/MM/yyyy}}" Width="120"/>
                            <DataGridTextColumn Header="المورد" Binding="{Binding Supplier.SupplierName}" Width="2*"/>
                            <DataGridTextColumn Header="طريقة الاسترداد" Binding="{Binding RefundMethod}" Width="150"/>
                            <DataGridTextColumn Header="الإجمالي" Binding="{Binding TotalRefundAmount, StringFormat={}{0:N2}}" Width="1.5*"/>
                            
                            <DataGridTemplateColumn Header="الحالة" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource BadgeSuccess}">
                                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrandSuccessBrush}" FontWeight="SemiBold" FontSize="11"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            
                            <DataGridTemplateColumn Header="إجراءات" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="إلغاء المرتجع"
                                                Foreground="{DynamicResource BrandDangerBrush}"
                                                Command="{Binding DataContext.CancelPurchaseReturnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <materialDesign:PackIcon Kind="Cancel" Width="16" Height="16"/>
                                        </Button>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
