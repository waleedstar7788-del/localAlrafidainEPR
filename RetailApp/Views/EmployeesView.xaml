<UserControl x:Class="RetailApp.Views.EmployeesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Loaded="UserControl_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Header -->
            <RowDefinition Height="Auto"/>  <!-- Stats & Actions -->
            <RowDefinition Height="*"/>     <!-- DataGrid -->
        </Grid.RowDefinitions>

        <!-- ═══ PAGE HEADER ═══ -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="إدارة الموظفين (HR)" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                <TextBlock Text="إدارة بيانات الموظفين، الأقسام، والمناصب الوظيفية" FontSize="13" 
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <!-- ═══ STATS & ACTIONS ROW ═══ -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <Border Grid.Column="0" Style="{StaticResource KpiCard}" Padding="20,10" Margin="0,0,16,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AccountGroupOutline" Foreground="{DynamicResource BrandPrimaryBrush}" Width="24" Height="24" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="إجمالي الموظفين" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"/>
                        <TextBlock Text="{Binding TotalEmployees}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button Command="{Binding ShowAddEmployeeDialogCommand}" Style="{StaticResource ModernPrimaryButton}" Padding="18,10" Height="40">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AccountPlus" Margin="0,0,8,0" Width="18" Height="18"/>
                        <TextBlock Text="إضافة موظف جديد" FontSize="13"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══ DATA TABLE ═══ -->
        <Border Grid.Row="2" Style="{StaticResource KpiCard}" Padding="0" ClipToBounds="True">
            <DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" AutoGenerateColumns="False" 
                      IsReadOnly="True" Style="{StaticResource ModernDataGrid}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="الرقم الوظيفي" Binding="{Binding EmployeeNumber}" Width="120"/>
                    
                    <DataGridTemplateColumn Header="اسم الموظف" Width="2*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <!-- Optional Avatar Placeholder -->
                                    <Border Background="{DynamicResource SurfaceHighlightStrongBrush}" CornerRadius="20" Width="32" Height="32" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding FullName[0]}" Foreground="{DynamicResource BrandPrimaryBrush}" 
                                                   FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Text="{Binding FullName}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    
                    <DataGridTextColumn Header="القسم" Binding="{Binding Department}" Width="1.5*"/>
                    <DataGridTextColumn Header="المسمى الوظيفي" Binding="{Binding JobTitle}" Width="1.5*"/>
                    <DataGridTextColumn Header="الراتب الأساسي" Binding="{Binding MonthlySalary, StringFormat={}{0:N2}}" Width="1*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource BrandSuccessBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    
                    <DataGridTemplateColumn Header="الحالة" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource BadgeSuccess}">
                                    <TextBlock Text="{Binding Status}" Foreground="{DynamicResource BrandSuccessBrush}" FontWeight="SemiBold" FontSize="11"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="إجراءات" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="عرض التفاصيل"
                                            Visibility="{Binding Status, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="EyeOutline" Width="16" Height="16"/>
                                    </Button>
                                    <Button Command="{Binding DataContext.ShowEditEmployeeDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource ModernIconButton}" Width="32" Height="32" ToolTip="تعديل"
                                            Visibility="{Binding Status, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
