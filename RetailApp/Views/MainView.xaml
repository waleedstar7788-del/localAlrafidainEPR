<UserControl x:Class="RetailApp.Views.MainView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <Grid Background="{DynamicResource BgBaseBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260"/> <!-- Sidebar -->
            <ColumnDefinition Width="*"/>   <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             SIDEBAR
        ═══════════════════════════════════════════════════════════ -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Border.Background>
                <DynamicResource ResourceKey="SidebarBackgroundBrush"/>
            </Border.Background>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>  <!-- Logo -->
                    <RowDefinition Height="*"/>     <!-- Nav Items -->
                    <RowDefinition Height="Auto"/>  <!-- User Profile -->
                </Grid.RowDefinitions>

                <!-- LOGO AREA -->
                <Border Grid.Row="0" Padding="20,24,20,16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Button Command="{Binding NavigateToDashboardCommand}" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            HorizontalContentAlignment="Stretch" Padding="0" Height="Auto"
                            materialDesign:ButtonAssist.CornerRadius="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Logo Icon -->
                            <Border Width="42" Height="42" CornerRadius="12" Margin="0,0,14,0" Background="Transparent" ClipToBounds="True">
                                <Image Source="pack://application:,,,/Assets/icon.png" Width="42" Height="42" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                            </Border>
                            <!-- App Name -->
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="الرافدين ERP" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="نظام إدارة الأعمال" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Button>
                </Border>

                <!-- NAVIGATION ITEMS -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,4,0,4">
                    <StackPanel>

                        <!-- ─── القائمة الرئيسية ─── -->
                        <TextBlock Text="القائمة الرئيسية" Style="{StaticResource SidebarSectionLabel}"/>

                        <Button Command="{Binding NavigateToDashboardCommand}" Style="{StaticResource SidebarNavButton}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="ViewDashboardOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="لوحة التحكم" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>

                        <!-- ─── المبيعات ─── -->
                        <TextBlock Text="المبيعات" Style="{StaticResource SidebarSectionLabel}"/>

                        <Button Command="{Binding NavigateToPosCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsSalesVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="CartOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="نقطة البيع" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToSalesCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsSalesVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Receipt" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="فواتير المبيعات" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToPurchasesCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsPurchasesVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Basket" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="فواتير المشتريات" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToReturnsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsSalesVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="SwapHorizontal" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="المرتجعات" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToInstallmentsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsSalesVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Calendar" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="الأقساط" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>

                        <!-- ─── المخزون ─── -->
                        <TextBlock Text="المخزون" Style="{StaticResource SidebarSectionLabel}"/>

                        <Button Command="{Binding NavigateToInventoryCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsInventoryVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="PackageVariant" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="المنتجات" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToWarehouseCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsInventoryVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Warehouse" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="المستودعات" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>

                        <!-- ─── العلاقات ─── -->
                        <TextBlock Text="العلاقات" Style="{StaticResource SidebarSectionLabel}"/>

                        <Button Command="{Binding NavigateToCustomersCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsCustomersVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="AccountGroup" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="العملاء" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToSuppliersCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsSuppliersVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Truck" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="الموردون" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>

                        <!-- ─── المحاسبة ─── -->
                        <TextBlock Text="المحاسبة" Style="{StaticResource SidebarSectionLabel}"/>

                        <Button Command="{Binding NavigateToExpensesCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsAccountingVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Cash" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="المصاريف والإيرادات" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToChartOfAccountsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsAccountingVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="FileTree" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="شجرة الحسابات" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToJournalEntriesCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsAccountingVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="BookOpenPageVariant" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="دفتر اليومية" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToReportsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsReportsVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="ChartBox" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="التقارير" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>

                        <!-- ─── الموارد البشرية ─── -->
                        <TextBlock Text="الموارد البشرية" Style="{StaticResource SidebarSectionLabel}"/>

                        <Button Command="{Binding NavigateToEmployeesCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsHRVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="AccountTie" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="الموظفون" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToPayrollCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsHRVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="CashMultiple" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="مسير الرواتب" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>

                        <!-- ─── النظام ─── -->
                        <TextBlock Text="النظام" Style="{StaticResource SidebarSectionLabel}"/>

                        <Button Command="{Binding NavigateToUsersCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsSettingsVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="ShieldAccount" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="المستخدمون" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToBackupCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsSettingsVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="CloudUpload" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="النسخ الاحتياطي" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToUpdateViewCommand}" Style="{StaticResource SidebarNavButton}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Update" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="تحديثات النظام" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToSettingsCommand}" Style="{StaticResource SidebarNavButton}" Visibility="{Binding IsSettingsVisible}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="Cog" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="الإعدادات" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>
                        <Button Command="{Binding NavigateToAboutCommand}" Style="{StaticResource SidebarNavButton}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Grid.Column="0" Kind="InformationOutline" Width="20" Height="20" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="حول البرنامج" VerticalAlignment="Center" FontSize="13.5"/>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- USER PROFILE CARD -->
                <Border Grid.Row="2" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Avatar with glow -->
                        <Border Width="40" Height="40" CornerRadius="20" Margin="0,0,12,0">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="0" Opacity="0.25" Color="#2563EB"/>
                            </Border.Effect>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="أ" FontSize="16" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- User Info -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="أحمد محمد" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandSuccessBrush}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="مدير النظام" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Logout -->
                        <Button Grid.Column="2" Command="{Binding LogoutCommand}" Style="{StaticResource ModernIconButton}" Width="34" Height="34" ToolTip="تسجيل الخروج">
                            <materialDesign:PackIcon Kind="LogoutVariant" Width="18" Height="18"/>
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════
             MAIN CONTENT AREA
        ═══════════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>   <!-- Top Bar -->
                <RowDefinition Height="Auto"/> <!-- Update Banner -->
                <RowDefinition Height="*"/>    <!-- Page Content -->
            </Grid.RowDefinitions>

            <!-- TOP BAR -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                <Border.Background>
                    <DynamicResource ResourceKey="TopBarBackgroundBrush"/>
                </Border.Background>
                <Grid Margin="20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation + Breadcrumb -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Command="{Binding GoBackCommand}" Style="{StaticResource ModernIconButton}" Width="34" Height="34" ToolTip="رجوع">
                            <materialDesign:PackIcon Kind="ArrowRight" Width="18" Height="18"/>
                        </Button>
                        <Button Command="{Binding GoForwardCommand}" Style="{StaticResource ModernIconButton}" Width="34" Height="34" ToolTip="تقدم" Margin="2,0,16,0">
                            <materialDesign:PackIcon Kind="ArrowLeft" Width="18" Height="18"/>
                        </Button>
                        <TextBlock Text="{Binding Breadcrumb}" Foreground="{DynamicResource TextSecondaryBrush}" 
                                   FontWeight="SemiBold" VerticalAlignment="Center" FontSize="14"/>
                    </StackPanel>

                    <!-- Global Search -->
                    <Border Grid.Column="1" Style="{StaticResource SearchBarBorder}" 
                            HorizontalAlignment="Center" Width="420" Margin="20,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon Kind="Magnify" Foreground="{DynamicResource TextMutedBrush}" 
                                                     VerticalAlignment="Center" Margin="14,0,10,0" Width="18" Height="18"/>
                            <TextBox Grid.Column="1" BorderThickness="0" Background="Transparent" 
                                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" FontSize="13"
                                     materialDesign:HintAssist.Hint="ابحث في النظام..." 
                                     materialDesign:HintAssist.Foreground="{DynamicResource TextMutedBrush}" 
                                     materialDesign:TextFieldAssist.DecorationVisibility="Hidden"/>
                            <!-- Keyboard shortcut badge -->
                            <Border Grid.Column="2" Background="{DynamicResource SurfaceHighlightBrush}" CornerRadius="6" Padding="8,3" 
                                    VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Ctrl+K" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right Actions -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Subscription Countdown Badge -->
                        <Button Command="{Binding NavigateToLicenseCommand}" Style="{StaticResource MaterialDesignFlatButton}" Height="34" Padding="0" Margin="0,0,10,0" ToolTip="متابعة الاشتراك وتأكيد الترخيص">
                            <Border CornerRadius="16" Padding="12,4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#1E293B"/>
                                        <Setter Property="BorderBrush" Value="#F59E0B"/>
                                        <Setter Property="BorderThickness" Value="1.5"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLicenseActivated}" Value="True">
                                                <Setter Property="Background" Value="#065F46"/>
                                                <Setter Property="BorderBrush" Value="#10B981"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <materialDesign:PackIcon Kind="ShieldCheck" Foreground="White" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding LicenseRemainingText}" FontSize="12" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Button>

                        <Button Command="{Binding ToggleThemeCommand}" Width="34" Height="34">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ModernIconButton}">
                                    <Setter Property="ToolTip" Value="الوضع الليلي"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="ToolTip" Value="الوضع النهاري"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <materialDesign:PackIcon Width="18" Height="18">
                                <materialDesign:PackIcon.Style>
                                    <Style TargetType="materialDesign:PackIcon">
                                        <Setter Property="Kind" Value="WeatherNight"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                                <Setter Property="Kind" Value="WeatherSunny"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </materialDesign:PackIcon.Style>
                            </materialDesign:PackIcon>
                        </Button>
                        <Button Command="{Binding NavigateToSettingsCommand}" Style="{StaticResource ModernIconButton}" Width="34" Height="34" ToolTip="الإعدادات" Margin="4,0">
                            <materialDesign:PackIcon Kind="CogOutline" Width="18" Height="18"/>
                        </Button>
                        <Button Command="{Binding ToggleNotificationsCommand}" Style="{StaticResource ModernIconButton}" Width="34" Height="34" ToolTip="الإشعارات">
                            <materialDesign:Badged Badge="3" BadgeBackground="{DynamicResource BrandDangerBrush}" BadgeForeground="White">
                                <materialDesign:PackIcon Kind="BellOutline" Width="18" Height="18"/>
                            </materialDesign:Badged>
                        </Button>

                        <!-- User Avatar with glow -->
                        <Border Width="36" Height="36" CornerRadius="18" Margin="12,0,0,0" Cursor="Hand">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="10" ShadowDepth="0" Opacity="0.2" Color="#2563EB"/>
                            </Border.Effect>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2563EB" Offset="0"/>
                                    <GradientStop Color="#7C3AED" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Text="أ" FontSize="14" FontWeight="Bold" Foreground="White" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- UPDATE NOTIFICATION BANNER -->
            <Border Grid.Row="1" Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
                    Background="{DynamicResource BrandPrimaryBrush}" Padding="16,10" Margin="0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon Kind="Creation" Foreground="White" Width="22" Height="22" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="1" Text="{Binding UpdateNotificationText}" Foreground="White" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center"/>
                    <Button Grid.Column="2" Command="{Binding NavigateToUpdateViewCommand}" Content="الاطلاع على الإضافات والتحديث" Style="{StaticResource MaterialDesignFlatButton}" Foreground="White" FontWeight="Bold" Margin="12,0"/>
                    <Button Grid.Column="3" Command="{Binding DismissUpdateNotificationCommand}" Style="{StaticResource ModernIconButton}" Width="28" Height="28" ToolTip="إغلاق الإشعار">
                        <materialDesign:PackIcon Kind="Close" Foreground="White" Width="16" Height="16"/>
                    </Button>
                </Grid>
            </Border>

            <!-- PAGE CONTENT -->
            <Border Grid.Row="2" Background="{DynamicResource BgBaseBrush}">
                <materialDesign:TransitioningContent Content="{Binding InnerCurrentView}" Margin="28,24">
                    <materialDesign:TransitioningContent.OpeningEffect>
                        <materialDesign:TransitionEffect Kind="FadeIn" Duration="0:0:0.25" />
                    </materialDesign:TransitioningContent.OpeningEffect>
                </materialDesign:TransitioningContent>
            </Border>
        </Grid>
    </Grid>
</UserControl>
